#!/usr/bin/env bash
# grim/slurp screenshot. --region for a selection (CleanShot-ish).
set -euo pipefail
out="${HOME}/Pictures/Screenshots"
mkdir -p "$out"
file="$out/$(date +%Y%m%d-%H%M%S).png"
if [[ "${1:-}" == "--region" ]]; then
  geom="$(slurp 2>/dev/null || true)"
  [[ -n "$geom" ]] || exit 0
  grim -g "$geom" "$file"
else
  grim "$file"
fi
if command -v wl-copy >/dev/null 2>&1; then
  wl-copy < "$file"
fi
command -v notify-send >/dev/null 2>&1 && notify-send "screenshot" "$file"
