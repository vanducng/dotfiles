# Sway (i3 on Wayland) — Linux counterpart of yabai + skhd.
# Modifiers match macOS:
#   Super (Mod4)  = cmd
#   Mod1          = option/alt
#   $meh          = ctrl+alt+shift          (app launchers)
#   $hyper        = Mod3  (Caps via xkb caps:hyper, same as Karabiner Hyper)
#   $hyper4       = ctrl+alt+shift+super    (physical 4-mod, no remap needed)
#
# Keybind table lives in docs/content/linux-desktop.md

set $mod    Mod4
set $alt    Mod1
set $meh    Control+Mod1+Shift
set $hyper  Mod3
set $hyper4 Control+Mod1+Shift+Mod4

set $term   ghostty
set $term2  kitty
set $menu   wofi --show drun --allow-images --insensitive
set $scripts ~/.config/sway/scripts

# -----------------------------------------------------------------------------
# Input — Caps is Hyper (hold) like Karabiner. Tap-escape needs kanata/uinput.
# -----------------------------------------------------------------------------
input type:keyboard {
    xkb_layout us
    xkb_options caps:hyper
    repeat_delay 250
    repeat_rate 35
}

input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
}

# -----------------------------------------------------------------------------
# Look — duskfox / yabai gaps (5px) / 2px iris border
# -----------------------------------------------------------------------------
font pango:JetBrainsMono Nerd Font 11
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

gaps inner 5
gaps outer 0
smart_gaps off
smart_borders on

client.focused          #d4a4ff #232136 #e0def4 #d4a4ff #d4a4ff
client.focused_inactive #393552 #191726 #6e6a86 #393552 #393552
client.unfocused        #393552 #191726 #6e6a86 #393552 #393552
client.urgent           #eb6f92 #191726 #e0def4 #eb6f92 #eb6f92
client.placeholder      #191726 #191726 #e0def4 #191726 #191726
client.background       #191726

output * bg #191726 solid_color

focus_follows_mouse no
mouse_warping output
workspace_auto_back_and_forth yes
floating_modifier $mod normal

# -----------------------------------------------------------------------------
# 1. Service control  (ctrl+alt+cmd - r)
# -----------------------------------------------------------------------------
bindsym Control+Mod1+$mod+r reload
bindsym Control+Mod1+$mod+Shift+r exec swaymsg exit

# -----------------------------------------------------------------------------
# 2. App launchers (meh) — focus existing window or launch
# -----------------------------------------------------------------------------
bindsym $meh+a exec $scripts/focus-or-launch com.mitchellh.ghostty ghostty
bindsym $meh+f exec $scripts/focus-or-launch kitty kitty
bindsym $meh+s exec $scripts/focus-or-launch firefox firefox
bindsym $meh+d exec $scripts/focus-or-launch firefox firefox
bindsym $meh+z exec $scripts/focus-or-launch firefox firefox
bindsym $meh+e exec $scripts/focus-or-launch firefox firefox
bindsym $meh+g exec $scripts/focus-or-launch cursor cursor code
bindsym $meh+k exec $scripts/focus-or-launch Slack slack
bindsym $meh+r exec $scripts/focus-or-launch org.telegram.desktop telegram-desktop
bindsym $meh+t exec $scripts/focus-or-launch discord discord
bindsym $meh+p exec $scripts/focus-or-launch org.pwmt.zathura zathura
bindsym $meh+o exec $scripts/focus-or-launch eog eog
bindsym $meh+w exec $scripts/focus-or-launch libreoffice libreoffice
bindsym $meh+q exec $scripts/focus-or-launch rhythmbox rhythmbox
bindsym $meh+c exec $scripts/focus-or-launch claude claude
bindsym $meh+v exec $scripts/focus-or-launch grok grok
bindsym $meh+Return exec $menu
bindsym $mod+space exec $menu

# -----------------------------------------------------------------------------
# 3. Window focus & warp  (ctrl+shift hjkl, cmd+shift h/l)
# -----------------------------------------------------------------------------
bindsym Control+Shift+h focus left
bindsym Control+Shift+j focus down
bindsym Control+Shift+k focus up
bindsym Control+Shift+l focus right
bindsym Control+Shift+Tab focus next

bindsym $mod+Shift+h move left
bindsym $mod+Shift+l move right
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up

# -----------------------------------------------------------------------------
# 4. Window resize — Caps+hjkl (Karabiner maps Hyper+hjkl to arrows) and arrows
# -----------------------------------------------------------------------------
bindsym $hyper+h resize shrink width 50 px
bindsym $hyper+j resize grow height 50 px
bindsym $hyper+k resize shrink height 50 px
bindsym $hyper+l resize grow width 50 px
bindsym $hyper+Left  resize shrink width 50 px
bindsym $hyper+Down  resize grow height 50 px
bindsym $hyper+Up    resize shrink height 50 px
bindsym $hyper+Right resize grow width 50 px

bindsym $hyper4+h resize shrink width 50 px
bindsym $hyper4+j resize grow height 50 px
bindsym $hyper4+k resize shrink height 50 px
bindsym $hyper4+l resize grow width 50 px
bindsym $hyper4+Left  resize shrink width 50 px
bindsym $hyper4+Down  resize grow height 50 px
bindsym $hyper4+Up    resize shrink height 50 px
bindsym $hyper4+Right resize grow width 50 px

# -----------------------------------------------------------------------------
# 5. Window insertion point  (shift+ctrl+alt hjkl) → split direction
# -----------------------------------------------------------------------------
bindsym Shift+Control+$alt+h splith
bindsym Shift+Control+$alt+l splith
bindsym Shift+Control+$alt+j splitv
bindsym Shift+Control+$alt+k splitv

# -----------------------------------------------------------------------------
# 6. Float / fullscreen  (hyper + space/f/n)
# -----------------------------------------------------------------------------
bindsym $hyper+space floating toggle
bindsym $hyper+f fullscreen toggle
bindsym $hyper+n fullscreen toggle global
bindsym $hyper4+space floating toggle
bindsym $hyper4+f fullscreen toggle
bindsym $hyper4+n fullscreen toggle global

# -----------------------------------------------------------------------------
# 7. Spaces — focus (alt+1..9)
# -----------------------------------------------------------------------------
bindsym $alt+1 workspace number 1
bindsym $alt+2 workspace number 2
bindsym $alt+3 workspace number 3
bindsym $alt+4 workspace number 4
bindsym $alt+5 workspace number 5
bindsym $alt+6 workspace number 6
bindsym $alt+7 workspace number 7
bindsym $alt+8 workspace number 8
bindsym $alt+9 workspace number 9

# -----------------------------------------------------------------------------
# 8. Spaces — send window without following (hyper+1..9, hyper+Tab)
# -----------------------------------------------------------------------------
bindsym $hyper+Tab move container to workspace back_and_forth
bindsym $hyper+1 move container to workspace number 1
bindsym $hyper+2 move container to workspace number 2
bindsym $hyper+3 move container to workspace number 3
bindsym $hyper+4 move container to workspace number 4
bindsym $hyper+5 move container to workspace number 5
bindsym $hyper+6 move container to workspace number 6
bindsym $hyper+7 move container to workspace number 7
bindsym $hyper+8 move container to workspace number 8
bindsym $hyper+9 move container to workspace number 9
bindsym $hyper+bracketright move container to workspace next

bindsym $hyper4+Tab move container to workspace back_and_forth
bindsym $hyper4+1 move container to workspace number 1
bindsym $hyper4+2 move container to workspace number 2
bindsym $hyper4+3 move container to workspace number 3
bindsym $hyper4+4 move container to workspace number 4
bindsym $hyper4+5 move container to workspace number 5
bindsym $hyper4+6 move container to workspace number 6
bindsym $hyper4+7 move container to workspace number 7
bindsym $hyper4+8 move container to workspace number 8
bindsym $hyper4+9 move container to workspace number 9
bindsym $hyper4+bracketright move container to workspace next

# -----------------------------------------------------------------------------
# 9. Spaces — send + follow (cmd+ctrl n/p/m/1..4)
# -----------------------------------------------------------------------------
bindsym $mod+Control+p move container to workspace prev; workspace prev
bindsym $mod+Control+n move container to workspace next; workspace next
bindsym $mod+Control+m move container to workspace number 9; workspace number 9
bindsym $mod+Control+1 move container to workspace number 1; workspace number 1
bindsym $mod+Control+2 move container to workspace number 2; workspace number 2
bindsym $mod+Control+3 move container to workspace number 3; workspace number 3
bindsym $mod+Control+4 move container to workspace number 4; workspace number 4

# -----------------------------------------------------------------------------
# 10. Displays — send + follow (cmd+ctrl arrows / ])
# -----------------------------------------------------------------------------
bindsym $mod+Control+Left  move container to output left;  focus output left
bindsym $mod+Control+Right move container to output right; focus output right
bindsym $mod+Control+bracketright move container to output right; focus output right

# -----------------------------------------------------------------------------
# 11. Layout — balance / gaps / rotate / mirror (hyper)
# -----------------------------------------------------------------------------
bindsym $hyper+e exec $scripts/balance
bindsym $hyper+r layout toggle split
bindsym $hyper+x layout splith
bindsym $hyper+y layout splitv
bindsym $hyper+i gaps inner current toggle 5
bindsym $hyper+o gaps inner current toggle 5

bindsym $hyper4+e exec $scripts/balance
bindsym $hyper4+r layout toggle split
bindsym $hyper4+x layout splith
bindsym $hyper4+y layout splitv
bindsym $hyper4+i gaps inner current toggle 5
bindsym $hyper4+o gaps inner current toggle 5

# -----------------------------------------------------------------------------
# Extra Linux (no macOS skhd equivalent)
# -----------------------------------------------------------------------------
bindsym $mod+Return exec $term
bindsym $mod+Shift+q kill
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -b 'Yes' 'swaymsg exit'
bindsym Print exec $scripts/screenshot
bindsym Shift+Print exec $scripts/screenshot --region
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# -----------------------------------------------------------------------------
# App → workspace pins (yabairc)
# -----------------------------------------------------------------------------
assign [app_id="com.mitchellh.ghostty"] 1
assign [app_id="kitty"] 15
assign [app_id="firefox"] 13
assign [class="Cursor"] 5
assign [class="Code"] 5
assign [class="Slack"] 9
assign [app_id="org.telegram.desktop"] 10
assign [class="discord"] 12
assign [app_id="org.pwmt.zathura"] 6
assign [app_id="eog"] 6

for_window [app_id="org.gnome.Calculator"] floating enable
for_window [app_id="org.gnome.Nautilus"] floating enable
for_window [app_id="org.gnome.Calendar"] floating enable
for_window [class="KeePassXC"] floating enable
for_window [class="zoom"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_type="dialog"] floating enable

# -----------------------------------------------------------------------------
# Startup
# -----------------------------------------------------------------------------
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec mako
exec waybar
exec $scripts/autotile
exec $term
