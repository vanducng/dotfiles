{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session-init.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/herdr-pane-name.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/dev-rules-reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|run_terminal_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.grok/hooks/bin/claude-compat-stdin.py\" python3 \"$HOME/.claude/hooks/pr-merge-guard.py\"",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash|run_terminal_command|Glob|list_dir|Grep|grep|Read|read_file|Edit|Write|MultiEdit|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.grok/hooks/bin/claude-compat-stdin.py\" python3 \"$HOME/.claude/hooks/scout-block.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "AskUserQuestion|ask_user_question",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/afplay /System/Library/Sounds/Pop.aiff",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/team-context-inject.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/subagent-init.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/langfuse-trace.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/skills/hooks/agent-notify.py\" grok stop",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/langfuse-trace.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|approval_required|action_required",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/skills/hooks/agent-notify.py\" grok notification",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
