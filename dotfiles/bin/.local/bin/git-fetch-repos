#!/usr/bin/env bash
# Fetch-only refresh for curated clones that affect day-to-day work.
# Never checkout/merge/stash. Platform repos stay on git-sync-repos.
#
# macOS: launchd StartInterval. Linux: systemd --user timer.
# Allowlist: $XDG_CONFIG_HOME/git-fetch-repos/repos (one path per line).
# Paths are absolute, ~/…, or relative to the first existing root in
# GIT_FETCH_ROOTS (default: $HOME/git:$HOME/work/git).
# No built-in defaults - empty/missing config is a no-op (public repo hygiene).
set -uo pipefail

PATH="${HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-/usr/bin:/bin}"
export PATH
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes -o IdentitiesOnly=yes -o ConnectTimeout=10 -o ServerAliveInterval=5 -o ServerAliveCountMax=2}"

LOG_DIR="${HOME}/.local/log"
mkdir -p "$LOG_DIR"
LOG="${LOG_DIR}/git-fetch-repos.log"
LOCKDIR="${LOG_DIR}/git-fetch-repos.lock.d"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/git-fetch-repos/repos"
ROOTS="${GIT_FETCH_ROOTS:-${HOME}/git:${HOME}/work/git}"

ts() { date '+%Y-%m-%d %H:%M:%S'; }
log() { printf '%s %s\n' "$(ts)" "$*" >>"$LOG"; }

resolve_dir() {
  local entry="$1" root
  entry="${entry%/}"
  if [[ "$entry" == /* ]]; then
    printf '%s\n' "$entry"
    return 0
  fi
  if [[ "$entry" == "~/"* ]]; then
    printf '%s\n' "${HOME}/${entry#~/}"
    return 0
  fi
  IFS=':' read -r -a roots <<<"$ROOTS"
  for root in "${roots[@]}"; do
    [[ -n "$root" ]] || continue
    if [[ -d "${root}/${entry}/.git" || -f "${root}/${entry}/.git" ]]; then
      printf '%s\n' "${root}/${entry}"
      return 0
    fi
  done
  printf '%s\n' "${roots[0]:-$HOME/git}/${entry}"
}

fetch_one() {
  local name="$1" dir="$2"
  if [[ ! -d "${dir}/.git" && ! -f "${dir}/.git" ]]; then
    log "skip ${name}: not a git repo (${dir})"
    return 0
  fi
  git -C "$dir" remote get-url origin >/dev/null 2>&1 || {
    log "skip ${name}: no origin"
    return 0
  }
  if git -C "$dir" fetch --prune --quiet origin >/dev/null 2>>"$LOG"; then
    log "ok ${name}: fetched"
  else
    log "fail ${name}: fetch (${dir})"
  fi
}

load_list() {
  local line
  if [[ ! -f "$CONFIG" ]]; then
    return 0
  fi
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="$(printf '%s' "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    [[ -n "$line" ]] || continue
    printf '%s\n' "$line"
  done <"$CONFIG"
}

acquire_lock() {
  GIT_FETCH_REPOS_LOCKDIR="$LOCKDIR"
  if mkdir "$GIT_FETCH_REPOS_LOCKDIR" 2>/dev/null; then
    printf '%s\n' "$$" >"${GIT_FETCH_REPOS_LOCKDIR}/pid"
    trap 'rm -f "${GIT_FETCH_REPOS_LOCKDIR:-}/pid"; rmdir "${GIT_FETCH_REPOS_LOCKDIR:-}" 2>/dev/null || true' EXIT
    return 0
  fi
  local pid=""
  pid="$(cat "${GIT_FETCH_REPOS_LOCKDIR}/pid" 2>/dev/null || true)"
  if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
    log "skip: already running (pid ${pid})"
    return 1
  fi
  # Dead or missing holder: reclaim.
  rm -f "${GIT_FETCH_REPOS_LOCKDIR}/pid" 2>/dev/null || true
  rmdir "$GIT_FETCH_REPOS_LOCKDIR" 2>/dev/null || {
    log "skip: stale lock not removable"
    return 1
  }
  mkdir "$GIT_FETCH_REPOS_LOCKDIR" 2>/dev/null || {
    log "skip: already running"
    return 1
  }
  printf '%s\n' "$$" >"${GIT_FETCH_REPOS_LOCKDIR}/pid"
  trap 'rm -f "${GIT_FETCH_REPOS_LOCKDIR:-}/pid"; rmdir "${GIT_FETCH_REPOS_LOCKDIR:-}" 2>/dev/null || true' EXIT
  return 0
}

main() {
  local entry dir count=0
  acquire_lock || return 0
  while IFS= read -r entry; do
    [[ -n "$entry" ]] || continue
    dir="$(resolve_dir "$entry")"
    fetch_one "$entry" "$dir"
    count=$((count + 1))
  done < <(load_list)
  if (( count == 0 )); then
    log "skip: no repos configured (${CONFIG})"
  fi
}

main
exit 0
