#!/usr/bin/env bash
# Fetch-only refresh for curated clones that affect day-to-day work.
# Never checkout/merge/stash. Platform repos stay on git-sync-repos.
#
# macOS: launchd StartInterval. Linux: systemd --user timer.
# Optional override list: $XDG_CONFIG_HOME/git-fetch-repos/repos (one path per line).
# Paths are absolute, or relative to the first existing root in GIT_FETCH_ROOTS
# (default: $HOME/git:$HOME/work/git).
set -u

PATH="${HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-/usr/bin:/bin}"
export PATH
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes -o IdentitiesOnly=yes}"

LOG_DIR="${HOME}/.local/log"
mkdir -p "$LOG_DIR"
LOG="${LOG_DIR}/git-fetch-repos.log"
LOCK="${LOG_DIR}/git-fetch-repos.lock"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/git-fetch-repos/repos"
ROOTS="${GIT_FETCH_ROOTS:-${HOME}/git:${HOME}/work/git}"

# Default allowlist when no config file exists (relative to a GIT_FETCH root).
DEFAULT_REPOS=(
  personal/vd-cli
  personal/miu-cr
  personal/miu-db
  personal/jira-cli
  personal/braze-cli
  personal/smartsheet-cli
  personal/voice-agent-cli
  personal/infra-template
  personal/oh-my-dsh
  dpl/infra
  dpl/goclaw
  dpl/goclaw-config
  dpl/code-review
  cnb/cnb-infra
)

ts() { date '+%Y-%m-%d %H:%M:%S'; }
log() { printf '%s %s\n' "$(ts)" "$*" >>"$LOG"; }

resolve_dir() {
  local entry="$1" root
  if [[ "$entry" == /* ]]; then
    printf '%s\n' "$entry"
    return 0
  fi
  if [[ "$entry" == "~/"* ]]; then
    printf '%s\n' "${HOME}/${entry#~/}"
    return 0
  fi
  IFS=':' read -r -a roots <<<"$ROOTS"
  for root in "${roots[@]}"; do
    [[ -n "$root" ]] || continue
    if [[ -d "${root}/${entry}/.git" || -f "${root}/${entry}/.git" ]]; then
      printf '%s\n' "${root}/${entry}"
      return 0
    fi
  done
  # Prefer first root for skip messages.
  printf '%s\n' "${roots[0]:-$HOME/git}/${entry}"
}

fetch_one() {
  local name="$1" dir="$2"
  if [[ ! -d "${dir}/.git" && ! -f "${dir}/.git" ]]; then
    log "skip ${name}: not a git repo (${dir})"
    return 0
  fi
  git -C "$dir" remote get-url origin >/dev/null 2>&1 || {
    log "skip ${name}: no origin"
    return 0
  }
  if git -C "$dir" fetch --prune --quiet origin >/dev/null 2>>"$LOG"; then
    log "ok ${name}: fetched"
  else
    log "fail ${name}: fetch (${dir})"
  fi
}

load_list() {
  local line
  if [[ -f "$CONFIG" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line%%#*}"
      line="$(printf '%s' "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
      [[ -n "$line" ]] || continue
      printf '%s\n' "$line"
    done <"$CONFIG"
    return 0
  fi
  printf '%s\n' "${DEFAULT_REPOS[@]}"
}

main() {
  local entry dir
  # Serialize: launchd kickstart + manual runs must not stampede the same remotes.
  # Use a global lock path so the EXIT trap still works after main returns (set -u).
  GIT_FETCH_REPOS_LOCKDIR="${LOCK}.d"
  if mkdir "$GIT_FETCH_REPOS_LOCKDIR" 2>/dev/null; then
    trap 'rmdir "${GIT_FETCH_REPOS_LOCKDIR:-}" 2>/dev/null || true' EXIT
  else
    local mtime=""
    mtime="$(stat -f %m "$GIT_FETCH_REPOS_LOCKDIR" 2>/dev/null || stat -c %Y "$GIT_FETCH_REPOS_LOCKDIR" 2>/dev/null || true)"
    if [[ ! "$mtime" =~ ^[0-9]+$ ]]; then
      log "skip: lock present (mtime unknown)"
      return 0
    fi
    local age=$(( $(date +%s) - mtime ))
    if (( age > 3600 )); then
      rmdir "$GIT_FETCH_REPOS_LOCKDIR" 2>/dev/null || { log "skip: stale lock not removable"; return 0; }
      mkdir "$GIT_FETCH_REPOS_LOCKDIR" 2>/dev/null || { log "skip: already running"; return 0; }
      trap 'rmdir "${GIT_FETCH_REPOS_LOCKDIR:-}" 2>/dev/null || true' EXIT
    else
      log "skip: already running"
      return 0
    fi
  fi
  while IFS= read -r entry; do
    [[ -n "$entry" ]] || continue
    dir="$(resolve_dir "$entry")"
    fetch_one "$entry" "$dir"
  done < <(load_list)
}

main
exit 0
