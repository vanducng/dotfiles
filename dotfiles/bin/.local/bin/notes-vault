#!/bin/bash
set -euo pipefail

export SYSMON_NVIM="${NOTES_VAULT_NVIM:-${SYSMON_NVIM:-}}"
export SYSMON_TMUX="${NOTES_VAULT_TMUX:-${SYSMON_TMUX:-}}"
export SYSMON_OPEN="${NOTES_VAULT_OPEN:-${SYSMON_OPEN:-}}"
here="$(cd "$(dirname "$0")" && pwd)"
if [[ "${1:-}" == stop ]]; then
  exec "$here/sysmon" stop
fi
exec "$here/sysmon" vault "$@"
