#!/usr/bin/env python3
# Rex learns an agent's status from OSC 7501, which Claude Code and Codex send on their own
# when they run straight in a Rex pane. Inside tmux (OpenRig seats) the sequence stops at
# tmux, so the agent's hooks call this with the hook JSON on stdin:
#   rex-agent-status <app>        e.g. claude-code
# It wraps the status in tmux passthrough (allow-passthrough on) and writes it to the
# seat's pane, so it reaches whichever Rex pane has the seat attached. Never fails a hook.
# The last status is kept on the pane (@rex_status); tmux.conf replays it when a client
# attaches, so a tile opened later shows it too:
#   rex-agent-status --replay <session>
# Straight in a Rex pane, Claude Code leaves its spinning ◐/◑ glyph out of the title (Rex has
# the status), so the pane header can't show it. There the hooks record the status and one
# background spinner per pane puts the glyph back on the title until the agent exits:
#   rex-agent-status --spin <state-file-base> <agent-pid> <tty>
# REX_AGENT_STATUS_LOG=<file> appends one line per hook call (event, which of TMUX, TMUX_PANE
# and REX_BLOCK were set, the pane found, what it did), never the hook's text.
import base64
import fcntl
import json
import os
import re
import subprocess
import sys
import tempfile
import time


def status(event):
    """(state, kind, msg) for a hook event, or None to leave the status alone."""
    name = event.get("hook_event_name", "")
    if name == "SessionStart":
        return "idle", None, None
    if name == "UserPromptSubmit":
        return "working", None, "Working"
    if name == "PreToolUse":
        tool = event.get("tool_input") or {}
        return "working", None, tool.get("description") or event.get("tool_name")
    if name == "PermissionRequest":
        return "blocked", "permission", "Allow " + str(event.get("tool_name") or "a tool") + "?"
    if name == "Notification" and event.get("notification_type") == "permission_prompt":
        return "blocked", "permission", event.get("message")
    if name == "Stop":
        return "done", None, "Done"
    if name == "SessionEnd":
        return "clear", None, None
    return None


def fields(app, state, kind, msg):
    pairs = ["app=" + app, "state=" + state]
    if kind:
        pairs.append("kind=" + kind)
    if msg:
        line = re.sub(r"[\x00-\x1f\x7f]+", " ", str(msg)).strip()[:200]
        pairs.append("msg=" + base64.b64encode(line.encode()).decode())
    return ":".join(pairs)


def wrap(pairs):
    osc = "\x1b]7501;" + pairs + "\x07"
    return "\x1bPtmux;" + osc.replace("\x1b", "\x1b\x1b") + "\x1b\\"


def sequence(app, state, kind, msg):
    return wrap(fields(app, state, kind, msg))


SPIN = 0.96  # Claude's own title spinner period
REX = os.path.expanduser("~/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS/rex")


def run(exes, *args):
    for exe in exes:
        try:
            out = subprocess.run([exe, *args], capture_output=True, text=True, timeout=2)
        except (OSError, subprocess.TimeoutExpired):
            continue
        return out.stdout.rstrip("\n") if out.returncode == 0 else None
    return None


def tmux(*args):
    return run(("tmux", "/opt/homebrew/bin/tmux", "/usr/local/bin/tmux"), *args)


def glyph(state, now):
    if state == "working":
        return "◐◑"[int(now / SPIN) % 2] + " "
    return "◉ " if state == "blocked" else ""


def titled(title, prefix):
    return prefix + re.sub(r"^[◐◑◉] ", "", title)


def agent_tty():
    """The agent's pid and tty: its hook processes have no tty, so walk up to the first that does."""
    pid = os.getppid()
    while pid > 1:
        row = (run(("ps", "/bin/ps"), "-o", "ppid=,tty=", "-p", str(pid)) or "").split()
        if len(row) != 2:
            break
        if row[1] != "??":
            return pid, "/dev/" + row[1]
        pid = int(row[0])
    return None, None


def seat_pane():
    """The agent's tmux pane: TMUX_PANE, else, under a tmux TERM, the one pane on the agent's tty.
    A launcher can start the agent without TMUX and TMUX_PANE while it still runs in a pane."""
    pane = os.environ.get("TMUX") and os.environ.get("TMUX_PANE")
    if pane or not os.environ.get("TERM", "").startswith(("tmux", "screen")):
        return pane
    _, tty = agent_tty()
    rows = (tmux("list-panes", "-a", "-F", "#{pane_tty} #{pane_id}") or "").splitlines() if tty else []
    panes = [row.split(" ")[1] for row in rows if row.startswith(tty + " ")]
    return panes[0] if len(panes) == 1 else None


def log(event, pane, action):
    path = os.environ.get("REX_AGENT_STATUS_LOG")
    if not path:
        return
    names = ",".join(n for n in ("TMUX", "TMUX_PANE", "REX_BLOCK") if os.environ.get(n)) or "-"
    with open(path, "a") as f:
        f.write("%s %s env=%s pane=%s %s\n" % (time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), event or "-", names, pane or "-", action))


def mark(state):
    """Record the pane's status, and start its spinner unless one is running."""
    base = os.path.join(tempfile.gettempdir(), "rex-agent-status-" + os.environ["REX_BLOCK"].replace(":", "-"))
    write(base + ".tmp", state)
    os.replace(base + ".tmp", base + ".state")
    with open(base + ".lock", "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return
    pid, tty = agent_tty()
    if tty:
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "--spin", base, str(pid), tty],
                         start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    return True


def spin(base, pid, tty):
    """Redraw the pane's title from its status until the agent exits."""
    with open(base + ".lock", "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return
        drawn = None
        while alive(pid):
            try:
                state = open(base + ".state").read()
            except OSError:
                state = ""
            if state != drawn or state == "working":
                title = json.loads(run(("rex", REX), "block", "call", "title") or "{}").get("title")
                new = title and titled(title, glyph(state, time.time()))
                if new and new != title:
                    write(tty, "\x1b]2;" + new + "\x07")
                drawn = state
            if state == "clear":
                return
            time.sleep(SPIN / 2)


def write(tty, text):
    with open(tty, "w") as f:
        f.write(text)


def replay(session):
    """Re-send each pane's last status, for a client that just attached."""
    for row in (tmux("list-panes", "-s", "-t", session, "-F", "#{pane_tty} #{@rex_status}") or "").splitlines():
        tty, _, pairs = row.partition(" ")
        if pairs:
            write(tty, wrap(pairs))


def main():
    if len(sys.argv) < 2:
        return
    if sys.argv[1] == "--replay":
        if len(sys.argv) > 2:
            replay(sys.argv[2])
        return
    if sys.argv[1] == "--spin":
        spin(sys.argv[2], int(sys.argv[3]), sys.argv[4])
        return
    pane = seat_pane()
    if not (pane or os.environ.get("REX_BLOCK")):
        log(None, None, "skipped: not in tmux or Rex")
        return
    try:
        event = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        log(None, pane, "skipped: not JSON")
        return
    if not isinstance(event, dict):
        event = {}
    name = event.get("hook_event_name")
    st = status(event)
    if not st:
        log(name, pane, "skipped: no status for this event")
        return
    if not pane:
        mark(st[0])
        log(name, None, "marked the Rex pane " + st[0])
        return
    tty = tmux("display-message", "-p", "-t", pane, "#{pane_tty}")
    if not tty:
        log(name, pane, "skipped: tmux gave no tty")
        return
    pairs = fields(sys.argv[1], *st)
    write(tty, wrap(pairs))
    if st[0] == "clear":
        tmux("set-option", "-p", "-u", "-t", pane, "@rex_status")
    else:
        tmux("set-option", "-p", "-t", pane, "@rex_status", pairs)
    log(name, pane, "wrote " + st[0])


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
