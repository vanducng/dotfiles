#!/usr/bin/env bash
set -euo pipefail

pane_id="${HERDR_ACTIVE_PANE_ID:-}"
[[ -n "$pane_id" ]] || { printf 'herdr-fingers: no active pane\n' >&2; exit 1; }

herdr_bin="${HERDR_BIN_PATH:-}"
if [[ ! -x "$herdr_bin" ]]; then
  herdr_bin="$(command -v herdr || true)"
fi
open_path="$(command -v open-path || true)"
[[ -n "$herdr_bin" ]] || { printf 'herdr-fingers: herdr is required\n' >&2; exit 1; }
[[ -n "$open_path" ]] || { printf 'herdr-fingers: open-path is required\n' >&2; exit 1; }
command -v rg >/dev/null 2>&1 || { printf 'herdr-fingers: ripgrep is required\n' >&2; exit 1; }
command -v fzf >/dev/null 2>&1 || { printf 'herdr-fingers: fzf is required\n' >&2; exit 1; }
rg --pcre2-version >/dev/null 2>&1 || { printf 'herdr-fingers: ripgrep must support PCRE2\n' >&2; exit 1; }

base_dir="${HERDR_ACTIVE_PANE_CWD:-$PWD}"
repo_root="$(git -C "$base_dir" rev-parse --show-toplevel 2>/dev/null || true)"
git_common_dir="$(git -C "$base_dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
main_root=""
[[ "${git_common_dir##*/}" == ".git" ]] && main_root="${git_common_dir%/.git}"
extensions='md|markdown|mdx|png|jpe?g|gif|webp|heic|heif|pdf|csv|tsv|xlsx|txt|json|ya?ml|toml|lua|sh|zsh|fish|py|js|jsx|ts|tsx|go|rs|java|kt|swift|c|cc|cpp|h|hpp'
url_pattern='https?://[^[:space:]<>\"]+'
path_prefix='(?:~|/|\./|\.\./)?'
segment='[[:alnum:]_@%+=,.-]'
location='(?::[0-9]+(?::[0-9]+)?)?'
path_pattern="${path_prefix}(?:${segment}+/)+${segment}*${location}"
file_pattern="${path_prefix}${segment}+\\.(?:${extensions})${location}"
quoted_pattern="\"[^\"\\r\\n]+(?:/|\\.(?:${extensions})${location})\"|'[^'\\r\\n]+(?:/|\\.(?:${extensions})${location})'"
bare_pattern='(?:Makefile|Dockerfile|Justfile|Taskfile|LICENSE|README|CHANGELOG)'
pattern="${url_pattern}|${quoted_pattern}|${path_pattern}|${file_pattern}|${bare_pattern}"

# These two are called once per candidate. Capturing their output with $(...)
# forks a subshell each time, which dominated the runtime: ~1.85ms per candidate,
# so a dense 500-line pane spent ~950ms here versus ~30ms in ripgrep. Both are
# pure parameter expansion, so they now publish through a global and the hot loop
# forks nothing.
normalize_candidate() {
  local previous
  NORMALIZED="$1"
  while true; do
    previous="$NORMALIZED"
    NORMALIZED="${NORMALIZED%[.,;:!?\)\]\>]}"
    [[ "$NORMALIZED" == "$previous" ]] && break
  done
  if [[ "$NORMALIZED" == \"*\" || "$NORMALIZED" == \'*\' ]]; then
    NORMALIZED="${NORMALIZED:1:${#NORMALIZED}-2}"
  fi
}

resolve_candidate() {
  local raw="$1" path root
  RESOLVED=""
  raw="${raw%:[0-9]*:[0-9]*}"
  raw="${raw%:[0-9]*}"
  case "$raw" in
    \~) raw="$HOME" ;;
    \~/*) raw="${HOME}${raw:1}" ;;
    \~*) return 1 ;;
  esac

  if [[ "$raw" == /* ]]; then
    [[ -f "$raw" || -d "$raw" ]] || return 1
    RESOLVED="${raw%/}"
    return 0
  fi

  raw="${raw#./}"
  for root in "$base_dir" "$repo_root" "$main_root"; do
    [[ -n "$root" ]] || continue
    path="$root/$raw"
    if [[ -f "$path" || -d "$path" ]]; then
      RESOLVED="${path%/}"
      return 0
    fi
  done
  return 1
}

copy_value() {
  if command -v pbcopy >/dev/null 2>&1; then
    printf '%s' "$1" | pbcopy || { printf 'herdr-fingers: pbcopy failed\n' >&2; return 1; }
  elif command -v wl-copy >/dev/null 2>&1; then
    printf '%s' "$1" | wl-copy || { printf 'herdr-fingers: wl-copy failed\n' >&2; return 1; }
  elif command -v xclip >/dev/null 2>&1; then
    printf '%s' "$1" | xclip -selection clipboard || { printf 'herdr-fingers: xclip failed\n' >&2; return 1; }
  elif command -v xsel >/dev/null 2>&1; then
    printf '%s' "$1" | xsel --clipboard --input || { printf 'herdr-fingers: xsel failed\n' >&2; return 1; }
  else
    printf 'herdr-fingers: no clipboard command found\n' >&2
    return 1
  fi
}

# `recent`/`recent-unwrapped` can block for ~16s on a pane hosting an idle
# alternate-screen agent: Herdr 0.8.0 collects text history for those, and the
# collection sits until it times out. Measured across 12 live panes, every
# `agent=claude status=idle` pane took 15.7-15.9s while every other pane
# (codex idle, claude working, plain shells) returned in 31-52ms.
#
# On the stalled panes themselves the fallback costs nothing: paired reads gave
# visible=81 rows vs recent=80, repeatably, because rows leaving the alternate
# screen never enter Herdr's host scrollback, so there is no extra history to
# fetch. `visible` is still viewport-only in general, so on a pane with deep
# scrollback it would scan less — an acceptable trade against a 16s freeze on
# every prefix+space. Raise HERDR_FINGERS_READ_TIMEOUT to buy history back.
#
# Bounding the read rather than hardcoding which agents stall keeps this correct
# if Herdr changes: the fast path simply stops timing out.
#
# `timeout` is not usable by bare name here: it commonly resolves to a pyenv
# shim rather than coreutils. When no coreutils timeout exists at all (a stock
# macOS box), fall back to a shell deadline rather than silently reverting to
# the unbounded read this change exists to remove.
read_timeout_bin=""
for candidate in "${HERDR_FINGERS_TIMEOUT_BIN:-}" gtimeout /opt/homebrew/bin/gtimeout /usr/bin/timeout; do
  [[ -n "$candidate" ]] || continue
  if command -v "$candidate" >/dev/null 2>&1 && "$candidate" --version 2>&1 | grep -qi coreutils; then
    read_timeout_bin="$candidate"
    break
  fi
done

# Kill the read once the deadline passes, mirroring coreutils' exit 124 so both
# paths are indistinguishable to the caller.
deadline_tmp=""
# Captures $? first and returns it: as an EXIT trap this function's status
# becomes the script's, so a hardcoded `return 0` masks a signal death (Ctrl-C
# reported 0), while letting it end on a failing `[[ -n ]]` test turned every
# clean run into exit 1. Passing the incoming status through is the only form
# that gets both right.
cleanup_deadline_tmp() {
  local rc=$?
  [[ -n "$deadline_tmp" ]] && rm -f "$deadline_tmp"
  deadline_tmp=""
  return "$rc"
}
# Clean up on signals, but re-raise so the exit status still reports the signal
# rather than the trap's own success — a parent checking $? must still see 130
# on Ctrl-C.
trap cleanup_deadline_tmp EXIT
trap 'cleanup_deadline_tmp; trap - INT; kill -INT $$' INT
trap 'cleanup_deadline_tmp; trap - TERM; kill -TERM $$' TERM

# The shell deadline exists for machines without coreutils, which are also the
# ones most likely to ship a sleep(1) that rejects fractional seconds. If it
# does, `sleep 0.1` fails instantly: the poll loop spins hot AND burns its whole
# budget in microseconds, killing even a healthy 40ms read. Probe once and drop
# to whole seconds rather than assume.
poll_step=""
poll_per_second=""
ensure_poll_granularity() {
  [[ -n "$poll_step" ]] && return 0
  if sleep 0.1 2>/dev/null; then
    poll_step="0.1"
    poll_per_second=10
  else
    poll_step="1"
    poll_per_second=1
  fi
}

read_pane_with_shell_deadline() {
  local source="$1" budget="$2" pid waited limit grace
  ensure_poll_granularity
  deadline_tmp="$(mktemp)" || return 1
  "$herdr_bin" pane read "$pane_id" --source "$source" --lines 500 --format text \
    >"$deadline_tmp" 2>/dev/null &
  pid=$!
  # Rounded up and floored at one tick so a sub-tick budget still waits once
  # instead of timing out before the read has any chance to finish.
  limit=$(awk -v b="$budget" -v p="$poll_per_second" \
    'BEGIN { n = int(b * p); if (n < b * p) n++; if (n < 1) n = 1; printf "%d", n }')
  waited=0
  while kill -0 "$pid" 2>/dev/null; do
    if ((waited >= limit)); then
      kill -TERM "$pid" 2>/dev/null || true
      # A process that ignores SIGTERM would make the following `wait` block
      # forever — the exact hang this deadline exists to prevent — so escalate.
      # Capped by the budget so a deliberately tight timeout is not silently
      # tripled by a flat one-second grace.
      grace=0
      while kill -0 "$pid" 2>/dev/null && ((grace < limit)); do
        sleep "$poll_step"
        ((grace++))
      done
      kill -KILL "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      # Whatever it managed to write is still worth scanning: it is strictly
      # more than the `visible` retry would return for an alternate-screen pane.
      if [[ -s "$deadline_tmp" ]]; then
        cat "$deadline_tmp"
        cleanup_deadline_tmp
        return 0
      fi
      cleanup_deadline_tmp
      return 124
    fi
    sleep "$poll_step"
    ((waited++))
  done
  if wait "$pid" || [[ -s "$deadline_tmp" ]]; then
    # Matches the timeout path: whatever the child managed to write is still
    # worth scanning, even if it then failed.
    cat "$deadline_tmp"
    cleanup_deadline_tmp
    return 0
  fi
  cleanup_deadline_tmp
  return 1
}

read_pane() {
  local source="$1" budget="$2"
  if [[ -n "$read_timeout_bin" ]]; then
    # -k is required, not optional: plain `timeout` sends TERM and then waits
    # forever if the child ignores it, which reintroduces the hang this guards.
    # The kill delay matches the budget so both this and the shell deadline give
    # the same worst case, rather than one scaling and the other staying flat.
    "$read_timeout_bin" -k "$budget" "$budget" "$herdr_bin" pane read "$pane_id" \
      --source "$source" --lines 500 --format text
  else
    read_pane_with_shell_deadline "$source" "$budget"
  fi
}

repair_wrapped_urls() {
  local width="$1"
  awk -v width="$width" '
    function ltrim(value) {
      sub(/^[[:space:]]+/, "", value)
      return value
    }
    function partial_scheme(value) {
      return value ~ /(^|[^[:alnum:]])(h|ht|htt|http|https|http:|https:|http:\/|https:\/)$/
    }
    function open_url(value, tail) {
      if (value !~ /https?:\/\//) return 0
      tail = value
      sub(/^.*https?:\/\//, "", tail)
      return tail != "" && tail !~ /[[:space:]<>")]/ && index(tail, "]") == 0
    }
    function flush() {
      if (buffer != "") print buffer
      buffer = ""
    }
    {
      original = $0
      if (buffer != "") buffer = buffer ltrim($0)
      else buffer = $0
      if (length(original) == width && (partial_scheme(buffer) || open_url(buffer))) next
      flush()
    }
    END { flush() }
  '
}

# 0.5s is ~9x the slowest healthy read measured across 14 live panes
# (min 33ms, median 44ms, max 57ms), so a pane that is merely large still
# finishes on the fast path while a stalled one gives up quickly.
pane_output=""
read_budget="${HERDR_FINGERS_READ_TIMEOUT:-0.5}"
if ! pane_output="$(read_pane recent-unwrapped "$read_budget")"; then
  # Includes exit 124 (timed out) and any transport error; `visible` is cheap
  # enough to always be worth one attempt before giving up. It is bounded too:
  # it measured 20-21ms on the panes that stall, but it reaches Herdr the same
  # way, so an unbounded retry could hang exactly where this must not.
  if ! pane_output="$(read_pane visible "$read_budget")"; then
    printf 'herdr-fingers: failed to read pane %s\n' "$pane_id" >&2
    exit 1
  fi
fi

pane_width="${HERDR_FINGERS_PANE_WIDTH:-}"
if [[ -z "$pane_width" ]] && command -v jq >/dev/null 2>&1; then
  pane_width="$(
    "$herdr_bin" pane layout --pane "$pane_id" 2>/dev/null |
      jq -r --arg pane "$pane_id" \
        '.result.layout.panes[]? | select(.pane_id == $pane) | .rect.width' |
      sed -n '1p' || true
  )"
fi
if [[ "$pane_width" =~ ^[0-9]+$ ]] && ((pane_width > 1)); then
  pane_output="$(printf '%s\n' "$pane_output" | repair_wrapped_urls "$((pane_width - 1))")"
fi

set +e
candidates="$(printf '%s\n' "$pane_output" \
  | awk '{ rows[NR] = $0 } END { for (i = NR; i >= 1; i--) print rows[i] }' \
  | rg --only-matching --no-line-number --no-filename --pcre2 "$pattern")"
match_status=$?
set -e
if ((match_status > 1)); then
  printf 'herdr-fingers: ripgrep exited with code %s\n' "$match_status" >&2
  exit "$match_status"
fi
matches="$(while IFS= read -r candidate; do
  [[ -n "$candidate" ]] || continue
  normalize_candidate "$candidate"
  candidate="$NORMALIZED"
  [[ -n "$candidate" ]] || continue
  if [[ "$candidate" == http://* || "$candidate" == https://* ]]; then
    printf '%s\t%s\n' "$candidate" "$candidate"
    continue
  fi
  resolve_candidate "$candidate" || continue
  [[ -n "$RESOLVED" && "$RESOLVED" != "${HOME%/}" ]] || continue
  printf '%s\t%s\n' "$RESOLVED" "$candidate"
done <<<"$candidates" | awk -F '\t' '!seen[$1]++ { sub(/^[^\t]*\t/, ""); print }')"

if [[ -z "$matches" ]]; then
  printf 'No paths or URLs found in the latest 500 rows.\n\nPress Enter to close.'
  read -r
  exit 0
fi

set +e
result="$(printf '%s\n' "$matches" | fzf \
  --layout=reverse \
  --border=none \
  --no-info \
  --expect=enter,ctrl-y,ctrl-e \
  --prompt='Pick > ' \
  --header='Newest first | Enter open | Ctrl-Y copy | Ctrl-E edit')"
fzf_status=$?
set -e
case "$fzf_status" in
  0) ;;
  1|130) exit 0 ;;
  *)
    printf 'herdr-fingers: fzf exited with code %s\n' "$fzf_status" >&2
    exit "$fzf_status"
    ;;
esac

action="${result%%$'\n'*}"
selection="${result#*$'\n'}"
if [[ "$selection" == "$result" ]]; then
  [[ "$action" != enter && "$action" != ctrl-y && "$action" != ctrl-e ]] || exit 0
  action="enter"
  selection="$result"
fi
[[ -n "$selection" ]] || exit 0

case "$action" in
  ctrl-y) copy_value "$selection" ;;
  ctrl-e) BASE_DIR="$base_dir" "$open_path" --editor "$selection" ;;
  *) BASE_DIR="$base_dir" "$open_path" --browser "$selection" ;;
esac
