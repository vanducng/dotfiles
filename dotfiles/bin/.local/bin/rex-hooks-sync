#!/usr/bin/env python3
# Puts the dotfiles' own extra hooks into a harness's live hooks file, which the harness or other
# tools rewrite at runtime and which holds private entries, so it is merged, never stowed:
# Claude Code's rex-title-spinner hooks, and cursor-agent's rex-status hook (cursor-agent has no
# `rexboard hook` support). `rexboard hooks install` merges rexboard's own hooks.
#   rex-hooks-sync [--apply] [--target FILE] [claude|cursor]
# For each hook event, the harness's marked hooks are replaced by the dotfiles ones, in place;
# every other key and hook stays. Prints the changed lines (no context, so no other values);
# --apply writes them, after a backup beside the file (FILE.bak-<UTC>). A second run changes nothing.
import argparse
import copy
import difflib
import json
import os
import sys
import tempfile
import time

# Harness: (source in the dotfiles repo, live file, mark in the command of each dotfiles hook,
# whether each event lists hooks directly as cursor does, rather than in matcher groups).
HARNESSES = {
    "claude": ("dotfiles/claude/.claude/settings.json", "~/.claude/settings.json", "rex-title-spinner", False),
    "cursor": ("dotfiles/cursor/.cursor/hooks/rex-status.json", "~/.cursor/hooks.json", "rex-status.py", True),
}


def is_rex(hook, mark):
    return isinstance(hook, dict) and mark in str(hook.get("command", ""))


def rex_groups(settings, mark):
    """The hook groups that run the marked command, by event, with only those hooks in each."""
    out = {}
    for event, groups in (settings.get("hooks") or {}).items():
        mine = [dict(g, hooks=[h for h in g.get("hooks", []) if is_rex(h, mark)]) for g in groups]
        mine = [g for g in mine if g["hooks"]]
        if mine:
            out[event] = mine
    return out


def merged(live, source, mark, flat):
    """`live` with its rex hooks replaced by `source`'s, each event's set where the old one was."""
    if flat:
        return merged_flat(live, source, mark)
    out = copy.deepcopy(live)
    hooks = out.setdefault("hooks", {})
    want = rex_groups(source, mark)
    for event in list(hooks) + [e for e in want if e not in hooks]:
        new, placed = [], False
        for group in hooks.get(event, []):
            rest = [h for h in group.get("hooks", []) if not is_rex(h, mark)]
            if len(rest) < len(group.get("hooks", [])) and not placed:
                new.extend(copy.deepcopy(want.get(event, [])))
                placed = True
            if rest:
                new.append(dict(group, hooks=rest))
        if not placed:
            new.extend(copy.deepcopy(want.get(event, [])))
        if new:
            hooks[event] = new
        else:
            hooks.pop(event, None)
    return out


def merged_flat(live, source, mark):
    """`merged` for files whose events list hooks directly, as cursor's hooks.json does."""
    out = copy.deepcopy(live)
    hooks = out.setdefault("hooks", {})
    want = {}
    for event, entries in (source.get("hooks") or {}).items():
        mine = [h for h in entries if is_rex(h, mark)]
        if mine:
            want[event] = mine
    for event in list(hooks) + [e for e in want if e not in hooks]:
        new, placed = [], False
        for hook in hooks.get(event, []):
            if is_rex(hook, mark):
                if not placed:
                    new.extend(copy.deepcopy(want.get(event, [])))
                    placed = True
            else:
                new.append(hook)
        if not placed:
            new.extend(copy.deepcopy(want.get(event, [])))
        if new:
            hooks[event] = new
        else:
            hooks.pop(event, None)
    return out


def text(settings, end="\n"):
    """The file as the harness writes it, ending as the live file does, so only real changes show."""
    return json.dumps(settings, indent=2, ensure_ascii=False) + end


def fail(why):
    print("rex-hooks-sync: " + why, file=sys.stderr)
    sys.exit(1)


def write(path, body, mode):
    """Writes `body` to a new file in `path`'s directory with `mode`, then renames it to `path`."""
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".rex-hooks-sync-")
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "w") as f:
            f.write(body)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def keep_old(target, body, mode):
    """Writes `body` to `FILE.bak-<UTC>`, never over an existing backup: `rexboard hooks install`
    may have made one this same second, so the next takes `-2`, then `-3`."""
    base = target + ".bak-" + time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    n = 1
    while True:
        path = base if n == 1 else "%s-%d" % (base, n)
        try:
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
        except FileExistsError:
            n += 1
            continue
        os.fchmod(fd, mode)
        with os.fdopen(fd, "w") as f:
            f.write(body)
        return path


def main(argv):
    parser = argparse.ArgumentParser(prog="rex-hooks-sync")
    parser.add_argument("harness", nargs="?", default="claude", choices=sorted(HARNESSES))
    parser.add_argument("--target", help="the live file (default: the harness's own)")
    parser.add_argument("--apply", action="store_true", help="write the change")
    args = parser.parse_args(argv)
    repo = os.path.realpath(os.path.join(os.path.dirname(os.path.realpath(__file__)), "../../../.."))
    source_rel, live_path, mark, flat = HARNESSES[args.harness]
    source_path = os.path.join(repo, source_rel)
    target = os.path.expanduser(args.target or live_path)
    # Neither is an error, so `make stow-rex` works on every host.
    if os.path.islink(target):
        print("%s is a symlink: this host stows it, so it already has the dotfiles hooks" % target)
        return
    if not os.path.exists(target):
        print("no %s on this host; nothing to merge" % target)
        return
    try:
        with open(source_path) as f:
            source = json.load(f)
    except (OSError, ValueError):
        fail("cannot read the dotfiles hooks at %s" % source_path)
    try:
        with open(target) as f:
            before = f.read()
        live = json.loads(before)
    except OSError as err:
        fail("cannot read %s: %s" % (target, err.strerror))
    except ValueError:
        fail("%s is not valid JSON; left alone" % target)
    end = "\n" if before.endswith("\n") else ""
    try:
        after = text(merged(live, source, mark, flat), end)
    except (AttributeError, TypeError):
        fail("%s has hooks in a shape this does not know; left alone" % target)
    if after == text(live, end):
        print("%s hooks in %s are up to date" % (mark, target))
        return
    sys.stdout.writelines(difflib.unified_diff(
        text(live, end).splitlines(True), after.splitlines(True), target, target + " (merged)", n=0))
    if not args.apply:
        print("dry run; --apply writes it")
        return
    # The backup holds the same private entries, so it gets the file's own mode.
    mode = os.stat(target).st_mode & 0o7777
    backup = keep_old(target, before, mode)
    write(target, after, mode)
    print("wrote %s (backup %s)" % (target, backup))


if __name__ == "__main__":
    main(sys.argv[1:])
