#!/usr/bin/env bash
# CNB OpenVPN on macOS (OpenVPN Connect) - keep work routes, drop full-tunnel.
#
# pfSense pushes `redirect-gateway def1` (0/1 + 128/1 via the CNB tun). That
# sends Cursor/Herdr/agent traffic through the VPN. When the tunnel flaps or
# blackholes internet, `agent` fails with "Failed to reach the Cursor API".
# Linux `cnb-openvpn` already ignores redirect-gateway; this is the Mac side.
#
#   cnb-openvpn-mac status
#   cnb-openvpn-mac split          # drop 0/1 + 128/1, then route the bastion via the tun
#   cnb-openvpn-mac patch-profiles # add pull-filter to CNB .ovpn copies
#   cnb-openvpn-mac doctor         # status + Cursor API reachability
set -euo pipefail

PROFILES_DIR="${HOME}/Library/Application Support/OpenVPN Connect/profiles"
OPENVPN_CONNECT_BIN="${OPENVPN_CONNECT_BIN:-/Applications/OpenVPN Connect/OpenVPN Connect.app/Contents/MacOS/OpenVPN Connect}"
CNB_GW_HINT="10.255."
PULL_FILTER_RG='pull-filter ignore "redirect-gateway"'
PULL_FILTER_DNS='pull-filter ignore "block-outside-dns"'

usage() {
  cat <<EOF
CNB OpenVPN on macOS - OpenVPN Connect helper.

  cnb-openvpn-mac profiles
  cnb-openvpn-mac start <profile-id>
  cnb-openvpn-mac stop
  cnb-openvpn-mac status
  cnb-openvpn-mac split           drop full-tunnel routes and route the bastion via the tun
  cnb-openvpn-mac repair          reapply those routes when the tun is up and they are missing
  cnb-openvpn-mac install-repair  reapply every 15s after a reconnect
  cnb-openvpn-mac patch-profiles  add pull-filter lines to CNB .ovpn profiles
  cnb-openvpn-mac doctor          status + https://api2.cursor.sh check

  stop/disconnect/disable disconnect the active VPN. OpenVPN Connect may show its GUI.

After OpenVPN Connect reconnects, run \`split\` again. That removes 0/1 and
128/1, then sends only the addresses in the routes file through the tun.
EOF
}

openvpn_connect() {
  [[ -x "$OPENVPN_CONNECT_BIN" ]] || {
    echo "cnb-openvpn-mac: OpenVPN Connect not found: $OPENVPN_CONNECT_BIN" >&2
    return 1
  }
  "$OPENVPN_CONNECT_BIN" "$@"
}

cmd_profiles() {
  openvpn_connect --list-profiles
}

cmd_connect() {
  local profile_id="${1:-}"
  if [[ -z "$profile_id" || "$#" -ne 1 ]]; then
    echo "usage: cnb-openvpn-mac start <profile-id>" >&2
    cmd_profiles
    return 2
  fi
  openvpn_connect "--connect-shortcut=${profile_id}"
}

cmd_disconnect() {
  [[ "$#" -eq 0 ]] || {
    echo "usage: cnb-openvpn-mac stop" >&2
    return 2
  }
  openvpn_connect --disconnect-shortcut
}

have_cnb_tun() {
  ifconfig 2>/dev/null | grep -q "inet ${CNB_GW_HINT}"
}

full_tunnel_gateways() {
  # Print unique gateways that own 0/1 or 128/1 (OpenVPN def1).
  netstat -rn -f inet 2>/dev/null | awk '
    $1 == "0/1" || $1 == "128.0/1" { print $2 }
  ' | sort -u
}

cmd_status() {
  local gws gw
  gws="$(full_tunnel_gateways || true)"
  if have_cnb_tun; then
    echo "cnb-openvpn-mac: CNB tun present (looking for ${CNB_GW_HINT}.x)"
  else
    echo "cnb-openvpn-mac: no CNB tun (${CNB_GW_HINT}.x) found"
  fi
  if [[ -z "${gws}" ]]; then
    echo "cnb-openvpn-mac: no full-tunnel routes (0/1, 128/1) - internet uses default route"
    return 0
  fi
  echo "cnb-openvpn-mac: FULL TUNNEL active - public IPv4 via VPN:"
  while IFS= read -r gw; do
    [[ -z "$gw" ]] && continue
    netstat -rn -f inet | awk -v g="$gw" '
      ($1 == "0/1" || $1 == "128.0/1") && $2 == g {
        print "  " $1 " -> " $2 " (" $NF ")"
      }'
  done <<<"$gws"
  echo "cnb-openvpn-mac: fix with: cnb-openvpn-mac split"
  return 1
}

_run_root() {
  local script="$1"
  local tmp
  if [[ "$(id -u)" -eq 0 ]]; then
    /bin/bash -c "$script"
    return
  fi
  if sudo -n true 2>/dev/null; then
    sudo -n /bin/bash -c "$script"
    return
  fi
  # GUI password prompt (works from agent/IDE without a TTY).
  if command -v osascript >/dev/null 2>&1; then
    tmp="$(mktemp /tmp/cnb-openvpn-mac.XXXXXX)"
    printf '%s\n' "$script" >"$tmp"
    chmod 700 "$tmp"
    if osascript -e "do shell script \"/bin/bash ${tmp}\" with administrator privileges" >/dev/null; then
      rm -f "$tmp"
      return 0
    fi
    rm -f "$tmp"
    return 1
  fi
  sudo /bin/bash -c "$script"
}

script_dir() {
  local p dir target
  p="${BASH_SOURCE[0]}"
  while [[ -L "$p" ]]; do
    dir="$(cd "$(dirname "$p")" && pwd)"
    target="$(readlink "$p")"
    if [[ "$target" != /* ]]; then
      p="${dir}/${target}"
    else
      p="$target"
    fi
  done
  cd "$(dirname "$p")" && pwd
}

routes_file() {
  if [[ -n "${CNB_VPN_ROUTES:-}" ]]; then
    printf '%s\n' "$CNB_VPN_ROUTES"
    return
  fi
  if [[ -f "${HOME}/.config/cnb-openvpn/routes" ]]; then
    printf '%s\n' "${HOME}/.config/cnb-openvpn/routes"
    return
  fi
  local dir
  dir="$(script_dir)"
  printf '%s\n' "$(cd "${dir}/../.." && pwd)/.config/cnb-openvpn/routes"
}

vpn_iface() {
  # The utun that owns the CNB address. Host routes must use -interface.
  # `route add -host $ip $peer` binds to en0 on macOS: the peer is not an
  # on-link gateway, so the packet never enters the tunnel.
  ifconfig 2>/dev/null | awk -v p="$CNB_GW_HINT" '
    $1 ~ /:$/ { iface=$1; sub(":$", "", iface) }
    $1 == "inet" && index($2, p) == 1 { print iface; exit }
  '
}

trim_route_line() {
  local line="$1"
  line="${line%%#*}"
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  printf '%s\n' "$line"
}

resolve_hostname() {
  local name="$1" resolver ips ip
  ips=""
  for resolver in "" 1.1.1.1 8.8.8.8; do
    if [[ -z "$resolver" ]]; then
      ips+=$'\n'"$(dig +short "$name" A 2>/dev/null || true)"
    else
      ips+=$'\n'"$(dig +short "@${resolver}" "$name" A 2>/dev/null || true)"
    fi
  done
  while IFS= read -r ip; do
    [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || continue
    printf '%s\n' "$ip"
  done <<<"$ips"
}

wildcard_names() {
  local zone="$1" routes="$2" labels line name
  printf '%s\n' "$zone"
  labels="$(dirname "$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$routes")")/labels/${zone}"
  [[ -f "$labels" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="$(trim_route_line "$line")"
    [[ -z "$line" ]] && continue
    if [[ "$line" == *.* ]]; then
      name="$line"
    else
      name="${line}.${zone}"
    fi
    printf '%s\n' "$name"
  done <"$labels"
}

read_route_targets() {
  local file="$1" line zone name
  [[ -f "$file" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="$(trim_route_line "$line")"
    [[ -z "$line" ]] && continue
    if [[ "$line" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
      printf '%s\n' "$line"
      continue
    fi
    if [[ "$line" =~ ^\*\.(.+)$ ]]; then
      zone="${BASH_REMATCH[1]}"
      if [[ ! "$zone" =~ ^[A-Za-z0-9.-]+\.[A-Za-z0-9.-]+$ ]]; then
        echo "cnb-openvpn-mac: skip invalid route entry: $line" >&2
        continue
      fi
      while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        resolve_hostname "$name"
      done < <(wildcard_names "$zone" "$file")
      continue
    fi
    if [[ ! "$line" =~ ^[A-Za-z0-9.-]+\.[A-Za-z0-9.-]+$ ]]; then
      echo "cnb-openvpn-mac: skip invalid route entry: $line" >&2
      continue
    fi
    resolve_hostname "$line"
  done <"$file" | awk 'NF && !seen[$0]++'
}

cmd_split() {
  local gws gw iface lan_if target script="" added="" bad=0 got
  gws="$(full_tunnel_gateways || true)"
  iface="$(vpn_iface || true)"
  while IFS= read -r gw; do
    [[ -z "$gw" ]] && continue
    script+="route -n delete -net 0.0.0.0/1 ${gw} 2>/dev/null || true; "
    script+="route -n delete -net 128.0.0.0/1 ${gw} 2>/dev/null || true; "
  done <<<"$gws"
  if [[ -n "$iface" ]]; then
    while IFS= read -r target; do
      [[ -z "$target" ]] && continue
      script+="route -n delete -host ${target} >/dev/null 2>&1 || true; "
      while IFS= read -r lan_if; do
        [[ -z "$lan_if" ]] && continue
        script+="route -n delete -ifscope ${lan_if} -host ${target} >/dev/null 2>&1 || true; "
      done < <(netstat -rn -f inet 2>/dev/null | awk '$1=="default" && $NF !~ /^utun/ { print $NF }' | sort -u)
      script+="route -n add -host ${target} -interface ${iface}; "
      printf '%s via %s\n' "$target" "$iface"
      added+="${target}"$'\n'
    done < <(read_route_targets "$(routes_file)")
  fi
  if [[ -z "$script" ]]; then
    echo "cnb-openvpn-mac: VPN tunnel is down. Connect, then run split." >&2
    return 1
  fi
  echo "cnb-openvpn-mac: removing full-tunnel routes..."
  _run_root "$script"
  if full_tunnel_gateways | grep -q .; then
    echo "cnb-openvpn-mac: full-tunnel routes still present" >&2
    cmd_status || true
    return 1
  fi
  while IFS= read -r target; do
    [[ -z "$target" ]] && continue
    got="$(route -n get "$target" 2>/dev/null | awk '/interface:/{print $2; exit}')"
    echo "$target interface: ${got:-missing}"
    if [[ -n "$iface" && "$got" != "$iface" ]]; then
      bad=1
    fi
  done <<<"$added"
  if [[ "$bad" -ne 0 ]]; then
    echo "cnb-openvpn-mac: host routes are not on ${iface}" >&2
    return 1
  fi
  echo "cnb-openvpn-mac: split tunnel OK"
  route -n get default 2>/dev/null | awk '/gateway:|interface:/{print}'
  return 0
}

routes_need_repair() {
  local iface target got
  iface="$(vpn_iface || true)"
  [[ -n "$iface" ]] || return 1
  while IFS= read -r target; do
    [[ -z "$target" ]] && continue
    got="$(route -n get "$target" 2>/dev/null | awk '/interface:/{print $2; exit}')"
    if [[ "$got" != "$iface" ]]; then
      return 0
    fi
  done < <(read_route_targets "$(routes_file)")
  return 1
}

cmd_repair() {
  if routes_need_repair; then
    cmd_split
  fi
}

cmd_install_repair() {
  local home user helper label dest
  home="${CNB_REPAIR_HOME:-$HOME}"
  user="${CNB_REPAIR_USER:-$USER}"
  helper="${home}/.local/bin/cnb-openvpn-mac"
  label="com.vanducng.cnb-openvpn-mac-repair"
  dest="/Library/LaunchDaemons/${label}.plist"
  if [[ "$(id -u)" -ne 0 ]]; then
    _run_root "CNB_REPAIR_HOME='${home}' CNB_REPAIR_USER='${user}' '${helper}' install-repair"
    return
  fi
  [[ -n "$home" && -x "$helper" ]] || {
    echo "cnb-openvpn-mac: install-repair needs CNB_REPAIR_HOME and the helper" >&2
    return 1
  }
  cat >"$dest" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${label}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${helper}</string>
    <string>repair</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>${home}</string>
    <key>USER</key>
    <string>${user}</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>15</integer>
  <key>StandardOutPath</key>
  <string>/Library/Logs/${label}.log</string>
  <key>StandardErrorPath</key>
  <string>/Library/Logs/${label}.log</string>
</dict>
</plist>
EOF
  chown root:wheel "$dest"
  chmod 644 "$dest"
  launchctl bootout "system/${label}" >/dev/null 2>&1 || true
  launchctl bootstrap system "$dest"
  launchctl enable "system/${label}"
  echo "cnb-openvpn-mac: ${label} installed for ${user}"
}

_is_cnb_profile() {
  local f="$1"
  grep -qE 'CNB_VPN|143\.59\.6\.146|74\.199\.124\.166|207\.98\.177\.126|Career Now Brands|CNB-VPN' "$f" 2>/dev/null
}

cmd_patch_profiles() {
  local f patched=0 skipped=0
  [[ -d "$PROFILES_DIR" ]] || {
    echo "cnb-openvpn-mac: missing profiles dir: $PROFILES_DIR" >&2
    return 1
  }
  shopt -s nullglob
  for f in "$PROFILES_DIR"/*.ovpn; do
    if ! _is_cnb_profile "$f"; then
      continue
    fi
    if grep -qF "$PULL_FILTER_RG" "$f"; then
      echo "cnb-openvpn-mac: already patched $(basename "$f")"
      skipped=$((skipped + 1))
      continue
    fi
    # Insert after the first `client` line when present; else prepend.
    if grep -q '^client$' "$f"; then
      awk -v rg="$PULL_FILTER_RG" -v dns="$PULL_FILTER_DNS" '
        BEGIN { done=0 }
        /^client$/ && !done {
          print
          print rg
          print dns
          done=1
          next
        }
        { print }
        END {
          if (!done) {
            print rg
            print dns
          }
        }
      ' "$f" >"${f}.tmp" && mv "${f}.tmp" "$f"
    else
      {
        echo "$PULL_FILTER_RG"
        echo "$PULL_FILTER_DNS"
        cat "$f"
      } >"${f}.tmp" && mv "${f}.tmp" "$f"
    fi
    echo "cnb-openvpn-mac: patched $(basename "$f")"
    patched=$((patched + 1))
  done
  echo "cnb-openvpn-mac: patch-profiles done (patched=$patched already=$skipped)"
  echo "cnb-openvpn-mac: reconnect the CNB profile in OpenVPN Connect, then run: cnb-openvpn-mac split"
}

cmd_doctor() {
  local rc=0
  cmd_status || rc=1
  if command -v curl >/dev/null 2>&1; then
    if curl -fsS -o /dev/null --connect-timeout 5 https://api2.cursor.sh/; then
      echo "cnb-openvpn-mac: api2.cursor.sh OK"
    else
      echo "cnb-openvpn-mac: api2.cursor.sh FAILED" >&2
      rc=1
    fi
  fi
  if command -v agent >/dev/null 2>&1; then
    # Prefer Cursor agent over other `agent` shims (e.g. grok).
    local agent_bin
    agent_bin="$(command -v agent)"
    if [[ -x "${HOME}/.local/bin/agent" ]]; then
      agent_bin="${HOME}/.local/bin/agent"
    fi
    if "$agent_bin" status >/dev/null 2>&1; then
      echo "cnb-openvpn-mac: cursor agent status OK"
    else
      echo "cnb-openvpn-mac: cursor agent status FAILED ($agent_bin)" >&2
      rc=1
    fi
  fi
  return "$rc"
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    profiles|list) cmd_profiles ;;
    start|connect) shift; cmd_connect "$@" ;;
    stop|disconnect|disable) shift; cmd_disconnect "$@" ;;
    status) cmd_status ;;
    split) cmd_split ;;
    repair) cmd_repair ;;
    install-repair) shift; cmd_install_repair "$@" ;;
    patch-profiles) cmd_patch_profiles ;;
    doctor) cmd_doctor ;;
    -h|--help|help|"") usage; [[ -n "$cmd" ]] || return 0 ;;
    *)
      echo "cnb-openvpn-mac: unknown command: $cmd" >&2
      usage >&2
      return 2
      ;;
  esac
}

main "$@"
