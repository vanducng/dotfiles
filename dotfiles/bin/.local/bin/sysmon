#!/bin/bash
set -euo pipefail

# One kitty overlay, one tmux session. meh+f raises the last window;
# first start creates btop, disk, and vault. Palette/CLI can still jump to any.

SESSION="${SYSMON_SESSION:-sysmon}"
SOCKET="${SYSMON_TMUX_SOCKET:-sysmon}"
HUB_TITLE="${SYSMON_TITLE:-sysmon-hub}"
BAR_TITLE="${SYSMON_BAR_TITLE:-herdr-bar}"
OVERLAY_GRID="${SYSMON_GRID:-6:6:1:1:4:4}"
OVERLAY_DOCK="${SYSMON_DOCK:-1:4:3:0:1:1}"
OVERLAY_DOCK_LEFT="${SYSMON_DOCK_LEFT:-1:4:0:0:1:1}"
# Hub width as a fraction of the app's space. 0.25 is one quarter.
DIA_HUB_RATIO="${SYSMON_DIA_RATIO:-0.25}"
# Comma-separated yabai app names. Focus one of these, then use the split chords.
SPLIT_APPS="${SYSMON_SPLIT_APPS:-Dia,ego lite}"
PLACE_GRID="$OVERLAY_GRID"
PLACE_LATER=1

usage() {
  cat <<'EOF'
Open system tools in one tmux session (kitty overlay).

  sysmon               raise the last window, centered
  sysmon dock          raise the last window as a right sidebar
  sysmon dock-left     raise the last window as a left sidebar
  sysmon dia           tile the hub on the left of the focused split app
  sysmon dia-right     tile the hub on the right of the focused split app
  sysmon processes     window 1: btop
  sysmon disk [path]   window 2: dua interactive (default: $HOME)
  sysmon vault         window 3: nvim on $OBSIDIAN_VAULT
  sysmon stop          kill the session and overlay

meh+f recenters the hub. Close it with cmd+w. cmd+opt+G docks on
the right (~1/4). cmd+opt+V docks on the left at the same width.
The overlay floats above whatever app is focused.
cmd+shift+opt+v / g tile a separate Kitty window running Herdr on the
left / right quarter of Dia. cmd+shift+opt+r / t do the same for ego lite.
That window is not inside tmux, so Herdr keeps its own prefix.
Ctrl+Shift+H and Ctrl+Shift+L move between them. The same chord
focuses the sidebar when it is already in place. Close that window
to dismiss it. First start creates windows 1-3 (btop, disk, vault)
and lands on btop. Later raises keep the last window and recreate any
of those three that were closed. Prefix and window keys come from
~/.tmux.conf.
EOF
}

resolve_bin() {
  local name="$1" override="${2:-}"
  local candidate
  if [[ -n "$override" ]]; then
    if [[ -x "$override" ]]; then
      printf '%s\n' "$override"
      return 0
    fi
    echo "sysmon: not executable: $override" >&2
    return 1
  fi
  for candidate in "/opt/homebrew/bin/$name" "/usr/local/bin/$name"; do
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  if command -v "$name" >/dev/null 2>&1; then
    command -v "$name"
    return 0
  fi
  local pkg="$name"
  case "$name" in
    dua) pkg="dua-cli" ;;
  esac
  echo "sysmon: $name not found; brew install $pkg" >&2
  return 1
}

kitty_bin() {
  resolve_bin kitty "${SYSMON_KITTY:-}"
}

tmux_bin() {
  resolve_bin tmux "${SYSMON_TMUX:-}"
}

tmux_conf() {
  local conf="${SYSMON_TMUX_CONF:-$HOME/.tmux.conf}"
  if [[ -r "$conf" ]]; then
    printf '%s\n' "$conf"
  fi
}

session_path() {
  local prefix=""
  if [[ -d /opt/homebrew/bin ]]; then
    prefix="/opt/homebrew/bin:"
  elif [[ -d /usr/local/bin ]]; then
    prefix="/usr/local/bin:"
  fi
  printf '%s%s:%s\n' "$prefix" "${HOME}/.local/bin" "${PATH}"
}

vault_path() {
  printf '%s\n' "${OBSIDIAN_VAULT:-$HOME/git/personal/vault}"
}

sanitize_launch_env() {
  unset NO_COLOR FORCE_COLOR
  case "${TERMINFO:-}" in
    *Ghostty.app*) unset TERMINFO ;;
  esac
}

tmux_cmd() {
  local tmux conf
  tmux="$(tmux_bin)"
  conf="$(tmux_conf)"
  if [[ -n "$conf" ]]; then
    env PATH="$(session_path)" "$tmux" -L "$SOCKET" -f "$conf" "$@"
  else
    env PATH="$(session_path)" "$tmux" -L "$SOCKET" "$@"
  fi
}

has_session() {
  tmux_cmd has-session -t "${1:-$SESSION}" 2>/dev/null
}

has_window() {
  local name="$1"
  tmux_cmd list-windows -t "$SESSION" -F '#{window_name}' 2>/dev/null | grep -qx "$name"
}

ensure_window() {
  local index="$1" name="$2" cwd="$3"
  shift 3
  if [[ -n "${SYSMON_OPEN:-}" ]]; then
    printf 'session: %s' "$SESSION"
    local conf
    conf="$(tmux_conf)"
    if [[ -n "$conf" ]]; then
      printf ' -f %s' "$conf"
    fi
    printf '\n'
    printf 'window: %s %s' "$index" "$name"
    for arg in "$@"; do
      printf ' %s' "$arg"
    done
    printf '\n'
    printf 'select: %s:%s\n' "$SESSION" "$index"
    return 0
  fi
  if ! has_session; then
    tmux_cmd new-session -d -s "$SESSION" -n "$name" -c "$cwd" -- "$@"
    tmux_cmd set-option -t "$SESSION" base-index 1
    tmux_cmd set-option -t "$SESSION" renumber-windows off
    local current
    current="$(tmux_cmd display-message -p -t "$SESSION" '#{window_index}')"
    if [[ "$current" != "$index" ]]; then
      tmux_cmd move-window -s "$SESSION:$name" -t "$SESSION:$index"
    fi
  elif ! has_window "$name"; then
    tmux_cmd new-window -t "$SESSION:$index" -n "$name" -c "$cwd" -- "$@"
  fi
  tmux_cmd select-window -t "$SESSION:$name"
}

yabai_bin() {
  resolve_bin yabai "${SYSMON_YABAI:-}" 2>/dev/null || true
}

wid_path() {
  printf '%s\n' "${SYSMON_WID_DIR:-${TMPDIR:-/tmp}}/sysmon.${1}.wid"
}

save_window_id() {
  local title="$1" id="$2"
  mkdir -p "$(dirname "$(wid_path "$title")")"
  printf '%s\n' "$id" >"$(wid_path "$title")"
}

find_window_ids() {
  local title="$1" yabai="$2"
  "$yabai" -m query --windows | python3 -c '
import json
import sys

title = sys.argv[1]
try:
    windows = json.load(sys.stdin)
except json.JSONDecodeError:
    raise SystemExit(0)
ids = [
    window["id"]
    for window in windows
    if window.get("app") == "kitty" and window.get("title") == title
]
ids.sort()
for window_id in ids:
    print(window_id)
' "$title" 2>/dev/null || true
}

apply_overlay() {
  local yabai="$1" id="$2" json floating sticky
  json="$("$yabai" -m query --windows --window "$id" 2>/dev/null || true)"
  [[ -n "$json" ]] || return 1
  read -r floating sticky < <(printf '%s' "$json" | python3 -c '
import json
import sys

try:
    window = json.load(sys.stdin)
except json.JSONDecodeError:
    raise SystemExit(1)
print("1" if window.get("is-floating") else "0", "1" if window.get("is-sticky") else "0")
')
  if [[ "$floating" != 1 ]]; then
    "$yabai" -m window "$id" --toggle float 2>/dev/null || true
  fi
  if [[ "$sticky" != 1 ]]; then
    "$yabai" -m window "$id" --toggle sticky 2>/dev/null || true
  fi
  "$yabai" -m window "$id" --sub-layer above 2>/dev/null || true
  "$yabai" -m window "$id" --grid "${PLACE_GRID:-$OVERLAY_GRID}" 2>/dev/null || true
}

resolve_window_id() {
  local title="$1" yabai="$2" id
  id="$(cat "$(wid_path "$title")" 2>/dev/null || true)"
  if [[ -n "$id" ]] && window_matches "$yabai" "$id" "$title"; then
    printf '%s\n' "$id"
    return 0
  fi
  id="$(find_window_ids "$title" "$yabai" | tail -n 1)"
  [[ -n "$id" ]] || return 1
  save_window_id "$title" "$id"
  printf '%s\n' "$id"
}

focus_window() {
  local title="$1" id yabai
  yabai="$(yabai_bin)"
  [[ -n "$yabai" ]] || return 1
  id="$(cat "$(wid_path "$title")" 2>/dev/null || true)"
  if [[ -n "$id" ]]; then
    if window_matches "$yabai" "$id" "$title"; then
      [[ "$PLACE_LATER" == 1 ]] && apply_overlay "$yabai" "$id" || true
      "$yabai" -m window "$id" --focus 2>/dev/null && return 0
    fi
  fi
  id="$(resolve_window_id "$title" "$yabai" || true)"
  [[ -n "$id" ]] || return 1
  if [[ "$PLACE_LATER" == 1 ]]; then
    apply_overlay "$yabai" "$id" || return 1
  fi
  "$yabai" -m window "$id" --focus 2>/dev/null
}

window_matches() {
  local yabai="$1" id="$2" title="$3" json
  json="$("$yabai" -m query --windows --window "$id" 2>/dev/null || true)"
  [[ -n "$json" ]] || return 1
  printf '%s' "$json" | python3 -c '
import json, sys
try:
    window = json.load(sys.stdin)
except json.JSONDecodeError:
    raise SystemExit(1)
raise SystemExit(0 if window.get("app") == "kitty" and window.get("title") == sys.argv[1] else 1)
' "$title"
}

place_title_later() {
  local title="$1"
  (
    local yabai id attempt
    yabai="$(yabai_bin)"
    [[ -n "$yabai" ]] || exit 0
    for attempt in 1 2 3 4 5 6; do
      id="$(find_window_ids "$title" "$yabai" | tail -n 1)"
      if [[ -n "$id" ]]; then
        save_window_id "$title" "$id"
        apply_overlay "$yabai" "$id" || true
        "$yabai" -m window "$id" --focus 2>/dev/null || true
        exit 0
      fi
      sleep 0.08
    done
  ) >/dev/null 2>&1 &
  disown
}

detach_exec() {
  python3 - "$@" <<'PY'
import os
import sys

argv = sys.argv[1:]
if os.fork() > 0:
    os._exit(0)
os.setsid()
if os.fork() > 0:
    os._exit(0)
devnull = os.open(os.devnull, os.O_RDWR)
os.dup2(devnull, 0)
os.dup2(devnull, 1)
os.dup2(devnull, 2)
if devnull > 2:
    os.close(devnull)
os.execv(argv[0], argv)
PY
}

open_window() {
  local title="$1"
  shift
  if [[ -n "${SYSMON_OPEN:-}" ]]; then
    printf 'open: %s' "$title"
    for arg in "$@"; do
      printf ' %s' "$arg"
    done
    printf '\n'
    return 0
  fi
  local kitty
  kitty="$(kitty_bin)"
  local group="${KITTY_GROUP:-sysmon}"
  detach_exec "$kitty" --single-instance --instance-group "$group" --wait-for-single-instance-window-close=no \
    --title "$title" \
    --override "macos_quit_when_last_window_closed no" --override "confirm_os_window_close 0" --override "font_size 13" \
    --override "hide_window_decorations no" --override "remember_window_size no" \
    --override "initial_window_width 1400" --override "initial_window_height 900" \
    -- "$@"
}

raise_or_open() {
  local title="$1"
  shift
  if [[ -n "${SYSMON_OPEN:-}" ]]; then
    if [[ -n "${SYSMON_FOCUSED:-}" ]]; then
      printf 'focus: %s\n' "$title"
      return 0
    fi
    open_window "$title" "$@"
    return 0
  fi
  if focus_window "$title"; then
    return 0
  fi
  open_window "$title" "$@"
  if [[ "$PLACE_LATER" == 1 ]]; then
    place_title_later "$title"
  fi
}

attach_hub() {
  local tmux
  tmux="$(tmux_bin)"
  raise_or_open "$HUB_TITLE" "$tmux" -L "$SOCKET" attach -t "$SESSION"
}

attach_bar() {
  local herdr
  if [[ -n "${SYSMON_OPEN:-}" ]]; then
    KITTY_GROUP=herdr-bar raise_or_open "$BAR_TITLE" "${SYSMON_HERDR:-herdr}"
    return 0
  fi
  if [[ -n "${SYSMON_HERDR:-}" ]]; then
    herdr="$(resolve_bin herdr "$SYSMON_HERDR" 2>/dev/null)" || {
      echo "sysmon: bad SYSMON_HERDR" >&2
      return 1
    }
  else
    herdr="$(resolve_bin herdr)" || return 1
  fi
  KITTY_GROUP=herdr-bar raise_or_open "$BAR_TITLE" "$herdr"
}

dia_state_path() {
  printf '%s\n' "${SYSMON_DIA_STATE:-${TMPDIR:-/tmp}/sysmon.dia}"
}

split_hub_open() {
  local yabai id
  yabai="$(yabai_bin)"
  [[ -n "$yabai" ]] || return 1
  id="$(resolve_window_id "$BAR_TITLE" "$yabai" 2>/dev/null || true)"
  [[ -n "$id" ]]
}

wait_hub_id() {
  local yabai="$1" id attempt
  for attempt in 1 2 3 4 5 6 7 8; do
    id="$(resolve_window_id "$BAR_TITLE" "$yabai" 2>/dev/null || true)"
    if [[ -n "$id" ]]; then
      printf '%s\n' "$id"
      return 0
    fi
    sleep 0.08
  done
  return 1
}

find_dia_target() {
  local app="$1" yabai json
  yabai="$(yabai_bin)"
  [[ -n "$yabai" && -n "$app" ]] || return 1
  json="$("$yabai" -m query --windows 2>/dev/null || true)"
  [[ -n "$json" ]] || return 1
  printf '%s' "$json" | python3 -c '
import json, sys
from collections import Counter
try:
    windows = json.load(sys.stdin)
except json.JSONDecodeError:
    raise SystemExit(1)
target = sys.argv[1]
def app_name(window):
    return (window.get("app") or "").replace("\u200e", "")
dias = [window for window in windows if app_name(window) == target]
if not dias:
    raise SystemExit(1)
focused = [window for window in dias if window.get("has-focus")]
if focused:
    space = focused[0].get("space")
else:
    space = Counter(window.get("space") for window in dias).most_common(1)[0][0]
on_space = [window for window in dias if window.get("space") == space]
pick = next((window for window in on_space if window.get("has-focus")), None)
if pick is None:
    pick = min(on_space, key=lambda window: (window.get("stack-index") or 0, window.get("id") or 0))
others = []
for window in windows:
    if window.get("space") != space or window.get("id") == pick.get("id"):
        continue
    if window.get("is-floating"):
        continue
    title = window.get("title") or ""
    if app_name(window) == "kitty" and title in {"sysmon-hub", "herdr-bar"}:
        continue
    others.append(str(window.get("id")))
print(space, pick.get("id"), ",".join(others))
' "$app"
}

choose_split_app() {
  local yabai json
  yabai="$(yabai_bin)"
  [[ -n "$yabai" ]] || return 1
  json="$("$yabai" -m query --windows 2>/dev/null || true)"
  [[ -n "$json" ]] || return 1
  printf '%s' "$json" | python3 -c '
import json, sys
allowed = [name.strip() for name in sys.argv[1].split(",") if name.strip()]
try:
    windows = json.load(sys.stdin)
except json.JSONDecodeError:
    raise SystemExit(1)
def app_name(window):
    return (window.get("app") or "").replace("\u200e", "")
focused = next((window for window in windows if window.get("has-focus")), None)
if focused and app_name(focused) in allowed:
    print(app_name(focused))
    raise SystemExit(0)
space = focused.get("space") if focused else None
if space is not None:
    present = [name for name in allowed if any(app_name(window) == name and window.get("space") == space and not window.get("is-floating") for window in windows)]
    if len(present) == 1:
        print(present[0])
        raise SystemExit(0)
present = [name for name in allowed if any(app_name(window) == name for window in windows)]
if len(present) == 1:
    print(present[0])
    raise SystemExit(0)
raise SystemExit(1)
' "$SPLIT_APPS"
}

window_origin() {
  local yabai="$1" id="$2"
  "$yabai" -m query --windows --window "$id" | python3 -c '
import json, sys
window = json.load(sys.stdin)
frame = window.get("frame") or {}
print(int(frame.get("x") or 0), int(frame.get("y") or 0), int(frame.get("w") or 0), int(frame.get("h") or 0))
'
}

dia_left_share() {
  local side="$1"
  if [[ "$side" == right ]]; then
    awk -v r="$DIA_HUB_RATIO" 'BEGIN { printf "%.4f\n", 1 - r }'
  else
    printf '%s\n' "$DIA_HUB_RATIO"
  fi
}

yabai_hold_motion() {
  local yabai="$1" share="$2" anim ratio
  anim="$("$yabai" -m config window_animation_duration 2>/dev/null || printf '0.0')"
  ratio="$("$yabai" -m config split_ratio 2>/dev/null || printf '0.50')"
  case "$anim" in
    0|0.|0.0|0.000000|"") anim=0.0 ;;
  esac
  YABAI_ANIM_PREV="$anim"
  YABAI_RATIO_PREV="$ratio"
  "$yabai" -m config window_animation_duration 0.0
  "$yabai" -m config split_ratio "$share"
}

yabai_release_motion() {
  local yabai="$1"
  [[ -n "$yabai" ]] || return 0
  "$yabai" -m config split_ratio "${YABAI_RATIO_PREV:-0.50}" 2>/dev/null || true
  "$yabai" -m config window_animation_duration "${YABAI_ANIM_PREV:-0.0}" 2>/dev/null || true
}

close_bar() {
  local only_floating="${1:-}" yabai id floating
  yabai="$(yabai_bin)"
  [[ -n "$yabai" ]] || return 0
  id="$(resolve_window_id "$BAR_TITLE" "$yabai" 2>/dev/null || true)"
  [[ -n "$id" ]] || return 0
  if [[ "$only_floating" == floating ]]; then
    floating="$("$yabai" -m query --windows --window "$id" 2>/dev/null | python3 -c 'import json,sys
try:
    print("1" if json.load(sys.stdin).get("is-floating") else "0")
except Exception:
    print("0")')"
    [[ "$floating" == 1 ]] || return 0
  fi
  "$yabai" -m window "$id" --close 2>/dev/null || true
  rm -f "$(wid_path "$BAR_TITLE")"
}

cmd_dia_off() {
  local state space layout yabai
  state="$(dia_state_path)"
  [[ -f "$state" ]] || return 0
  IFS='|' read -r space layout _ _ <"$state" || true
  rm -f "$state"
  [[ -n "${SYSMON_OPEN:-}" ]] && return 0
  yabai="$(yabai_bin)"
  [[ -n "$yabai" ]] || return 0
  yabai_hold_motion "$yabai" "$DIA_HUB_RATIO"
  close_bar
  if [[ -n "${space:-}" && -n "${layout:-}" ]]; then
    "$yabai" -m space "$space" --layout "$layout" 2>/dev/null || true
  fi
  yabai_release_motion "$yabai"
}

dia_insert() {
  if [[ "$1" == right ]]; then
    printf 'east\n'
  else
    printf 'west\n'
  fi
}

# One correction after the split: side-by-side, hub on the requested side.
settle_dia_split() {
  local yabai="$1" hub="$2" dia="$3" side="$4"
  local hx hy hw hh dx dy dw dh share
  read -r hx hy hw hh < <(window_origin "$yabai" "$hub")
  read -r dx dy dw dh < <(window_origin "$yabai" "$dia")
  if [[ $(( hy + hh )) -le "$dy" || $(( dy + dh )) -le "$hy" ]]; then
    "$yabai" -m window "$hub" --toggle split 2>/dev/null || true
    read -r hx hy hw hh < <(window_origin "$yabai" "$hub")
    read -r dx dy dw dh < <(window_origin "$yabai" "$dia")
  fi
  if [[ "$side" == right && "$hx" -lt "$dx" ]] || [[ "$side" != right && "$hx" -gt "$dx" ]]; then
    "$yabai" -m window "$hub" --swap "$dia" 2>/dev/null || true
  fi
  share="$(dia_left_share "$side")"
  "$yabai" -m window "$hub" --ratio "abs:${share}" 2>/dev/null || true
}

arrange_dia_split() {
  local side="$1" space="$2" dia="$3" others="$4" app="$5" kept_layout="${6:-}"
  local yabai hub layout id share
  yabai="$(yabai_bin)"
  hub="$(wait_hub_id "$yabai")" || return 1
  if [[ -n "$kept_layout" ]]; then
    layout="$kept_layout"
  else
    layout="$("$yabai" -m query --spaces --space "$space" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("type") or "bsp")')"
  fi
  share="$(dia_left_share "$side")"
  yabai_hold_motion "$yabai" "$share"
  "$yabai" -m window "$hub" --sub-layer auto 2>/dev/null || true
  if [[ "$("$yabai" -m query --windows --window "$hub" | python3 -c 'import json,sys; print("1" if json.load(sys.stdin).get("is-sticky") else "0")')" == 1 ]]; then
    "$yabai" -m window "$hub" --toggle sticky 2>/dev/null || true
  fi
  "$yabai" -m window "$hub" --space "$space" 2>/dev/null || true
  "$yabai" -m space "$space" --layout bsp 2>/dev/null || true
  if [[ -n "$others" ]]; then
    IFS=',' read -r -a ids <<<"$others"
    for id in "${ids[@]}"; do
      [[ -n "$id" ]] || continue
      "$yabai" -m window "$dia" --stack "$id" 2>/dev/null || true
    done
  fi
  # One insert. A later warp splits again and that second split stays at 1/2.
  "$yabai" -m window "$dia" --insert "$(dia_insert "$side")" 2>/dev/null || true
  if [[ "$("$yabai" -m query --windows --window "$hub" | python3 -c 'import json,sys; print("1" if json.load(sys.stdin).get("is-floating") else "0")')" == 1 ]]; then
    "$yabai" -m window "$hub" --toggle float 2>/dev/null || true
  else
    "$yabai" -m window "$hub" --warp "$dia" 2>/dev/null || true
  fi
  settle_dia_split "$yabai" "$hub" "$dia" "$side"
  yabai_release_motion "$yabai"
  "$yabai" -m window "$hub" --ratio "abs:${share}" 2>/dev/null || true
  printf '%s|%s|%s|%s\n' "$space" "$layout" "$side" "$app" >"$(dia_state_path)"
  "$yabai" -m space --focus "$space" 2>/dev/null || true
  "$yabai" -m window "$dia" --focus 2>/dev/null || true
}

retarget_dia_side() {
  local side="$1" app="$2"
  local state space layout yabai hub dia
  state="$(dia_state_path)"
  IFS='|' read -r space layout _ <"$state" || return 1
  yabai="$(yabai_bin)"
  [[ -n "$yabai" && -n "$app" ]] || return 1
  hub="$(resolve_window_id "$BAR_TITLE" "$yabai" 2>/dev/null || true)"
  [[ -n "$hub" ]] || return 1
  dia="$(printf '%s' "$("$yabai" -m query --windows)" | python3 -c '
import json, sys
space = int(sys.argv[1])
target = sys.argv[2]
windows = json.load(sys.stdin)
def app_name(window):
    return (window.get("app") or "").replace("\u200e", "")
dias = [window for window in windows if app_name(window) == target and window.get("space") == space and not window.get("is-floating")]
if not dias:
    raise SystemExit(1)
print(max(dias, key=lambda window: (window.get("frame") or {}).get("w") or 0)["id"])
' "$space" "$app")" || return 1
  yabai_hold_motion "$yabai" "$(dia_left_share "$side")"
  settle_dia_split "$yabai" "$hub" "$dia" "$side"
  yabai_release_motion "$yabai"
  printf '%s|%s|%s|%s\n' "$space" "$layout" "$side" "$app" >"$state"
  "$yabai" -m window "$dia" --focus 2>/dev/null || true
}

focus_bar_if_placed() {
  local side="$1" space="$2" app="$3" yabai hub
  yabai="$(yabai_bin)" || return 1
  hub="$(resolve_window_id "$BAR_TITLE" "$yabai" 2>/dev/null || true)"
  [[ -n "$hub" ]] || return 1
  "$yabai" -m query --windows | python3 -c '
import json, sys
side, space, app, hub = sys.argv[1], int(sys.argv[2]), sys.argv[3], int(sys.argv[4])
try:
    windows = json.load(sys.stdin)
except json.JSONDecodeError:
    raise SystemExit(1)
def app_name(window):
    return (window.get("app") or "").replace("\u200e", "")
bar = next((window for window in windows if window.get("id") == hub), None)
if not bar or bar.get("is-floating") or bar.get("space") != space:
    raise SystemExit(1)
others = [window for window in windows if app_name(window) == app and window.get("space") == space and not window.get("is-floating")]
if not others:
    raise SystemExit(1)
other = max(others, key=lambda window: (window.get("frame") or {}).get("w") or 0)
bar_x = (bar.get("frame") or {}).get("x") or 0
other_x = (other.get("frame") or {}).get("x") or 0
if side == "right" and bar_x < other_x:
    raise SystemExit(1)
if side != "right" and bar_x > other_x:
    raise SystemExit(1)
' "$side" "$space" "$app" "$hub" || return 1
  "$yabai" -m window "$hub" --focus 2>/dev/null
}

cmd_dia() {
  local side="${1:-left}" requested="${2:-}" app="" space layout active saved dia others kept_layout="" kept_space="" yabai=""
  if [[ -n "${SYSMON_OPEN:-}" ]]; then
    printf 'dia: %s\n' "$DIA_HUB_RATIO"
    printf 'side: %s\n' "$side"
    printf 'app: %s\n' "${requested:-$SPLIT_APPS}"
    attach_bar
    return 0
  fi
  if [[ -f "$(dia_state_path)" ]]; then
    IFS='|' read -r space layout active saved <"$(dia_state_path)" || true
    active="${active:-left}"
    if [[ -n "$requested" ]]; then
      app="$requested"
    else
      app="$(choose_split_app 2>/dev/null || true)"
      [[ -n "$app" ]] || app="$saved"
    fi
    if ! split_hub_open; then
      # Closing the hub drops it out of the tree and leaves the other windows
      # tiled at random. The state file still says the split is on, so the
      # next press would only restore that mess. Put the space back, then
      # build the split again in this same press.
      kept_layout="$layout"
      kept_space="$space"
      if [[ -n "${space:-}" && -n "$kept_layout" ]]; then
        yabai="$(yabai_bin)"
        if [[ -n "$yabai" ]]; then
          yabai_hold_motion "$yabai" "$DIA_HUB_RATIO"
          "$yabai" -m space "$space" --layout "$kept_layout" 2>/dev/null || true
          yabai_release_motion "$yabai"
        fi
      fi
    elif [[ "$app" == "$saved" && "$active" == "$side" ]]; then
      if focus_bar_if_placed "$side" "$space" "$app"; then
        return 0
      fi
      kept_layout="$layout"
      kept_space="$space"
    elif [[ "$app" == "$saved" ]]; then
      retarget_dia_side "$side" "$saved" || cmd_dia_off
      return 0
    else
      cmd_dia_off
    fi
  fi
  if [[ -n "$requested" ]]; then
    app="$requested"
  elif [[ -z "$app" ]]; then
    app="$(choose_split_app)" || {
      echo "sysmon: focus one of: $SPLIT_APPS" >&2
      return 1
    }
  fi
  if ! read -r space dia others < <(find_dia_target "$app"); then
    echo "sysmon: $app is not open" >&2
    return 1
  fi
  if [[ -n "$kept_space" && "$space" != "$kept_space" ]]; then
    kept_layout=""
  fi
  PLACE_LATER=0
  attach_bar
  arrange_dia_split "$side" "$space" "$dia" "$others" "$app" "$kept_layout"
}

ensure_processes_window() {
  local btop
  btop="$(resolve_bin btop "${SYSMON_BTOP:-}")"
  ensure_window 1 processes "$HOME" "$btop"
}

ensure_disk_window() {
  local dua path="${1-}"
  path="${path:-$HOME}"
  if [[ ! -d "$path" ]]; then
    echo "sysmon: disk path not found: $path" >&2
    return 1
  fi
  dua="$(resolve_bin dua "${SYSMON_DUA:-}")"
  ensure_window 2 disk "$path" "$dua" i "$path"
}

ensure_vault_window() {
  local nvim vault zsh
  vault="$(vault_path)"
  if [[ ! -d "$vault" ]]; then
    echo "sysmon: vault not found: $vault" >&2
    return 1
  fi
  nvim="$(resolve_bin nvim "${SYSMON_NVIM:-}")"
  zsh="${SYSMON_ZSH:-/bin/zsh}"
  ensure_window 3 vault "$vault" "$zsh" -lc "source \"\$HOME/.zshrc\" >/dev/null 2>&1 || true; exec \"$nvim\" ."
}

# Create the designed hub windows (btop, disk, vault). Keep the current
# window when the session already exists; land on btop on first start.
# Recreate any of those three that were closed so meh+f always has the hub.
ensure_hub_windows() {
  local current="" created=0 vault
  if has_session; then
    current="$(tmux_cmd display-message -p -t "$SESSION" '#{window_name}')"
  else
    created=1
  fi
  ensure_processes_window || echo "sysmon: skipping processes window" >&2
  ensure_disk_window "$HOME" || echo "sysmon: skipping disk window" >&2
  # Quiet when vault path is missing; still guard nvim/resolve failures.
  vault="$(vault_path)"
  if [[ -d "$vault" ]]; then
    ensure_vault_window || echo "sysmon: skipping vault window" >&2
  fi
  if ! has_session; then
    echo "sysmon: no hub windows could be created" >&2
    return 1
  fi
  if [[ "$created" == 1 ]]; then
    if has_window processes; then
      tmux_cmd select-window -t "$SESSION:=processes"
    fi
  elif [[ -n "$current" ]] && has_window "$current"; then
    tmux_cmd select-window -t "$SESSION:=$current"
  fi
}

cmd_show() {
  if [[ -z "${SYSMON_OPEN:-}" ]]; then
    close_bar floating
  fi
  PLACE_GRID="${1:-$OVERLAY_GRID}"
  if [[ -n "${SYSMON_OPEN:-}" ]]; then
    printf 'show: %s\n' "$SESSION"
    printf 'place: %s\n' "$PLACE_GRID"
    attach_hub
    return 0
  fi
  ensure_hub_windows
  attach_hub
}

cmd_processes() {
  ensure_processes_window
  attach_hub
}

cmd_disk() {
  ensure_disk_window "${1-}"
  attach_hub
}

cmd_vault() {
  ensure_vault_window
  attach_hub
}

cmd_stop() {
  local tmux name yabai pid
  tmux="$(tmux_bin)"
  if [[ -n "${SYSMON_OPEN:-}" ]]; then
    printf 'stopped: %s\n' "$SESSION"
    return 0
  fi
  if "$tmux" -L "$SOCKET" has-session -t "$SESSION" 2>/dev/null; then
    "$tmux" -L "$SOCKET" kill-session -t "$SESSION"
    printf 'stopped: %s\n' "$SESSION"
  fi
  for name in sysmon-processes sysmon-disk notes-vault; do
    if "$tmux" has-session -t "$name" 2>/dev/null; then
      "$tmux" kill-session -t "$name"
      printf 'stopped: %s\n' "$name"
    fi
  done
  yabai="$(yabai_bin)"
  if [[ -n "$yabai" ]]; then
    while read -r pid; do
      [[ -n "$pid" ]] || continue
      kill "$pid" 2>/dev/null || true
    done < <("$yabai" -m query --windows | python3 -c '
import json
import sys

try:
    windows = json.load(sys.stdin)
except json.JSONDecodeError:
    raise SystemExit(0)
seen = set()
for window in windows:
    title = window.get("title") or ""
    if window.get("app") != "kitty":
        continue
    if title in {"sysmon-hub", "sysmon-processes", "sysmon-disk", "notes-vault"}:
        pid = window.get("pid")
        if pid and pid not in seen:
            seen.add(pid)
            print(pid)
')
    for name in sysmon-hub sysmon-processes sysmon-disk notes-vault; do
      rm -f "$(wid_path "$name")"
    done
  fi
}

main() {
  local cmd="${1:-}" title
  sanitize_launch_env
  case "$cmd" in
    "" | show | center) cmd_show "$OVERLAY_GRID" ;;
    dock | sidebar) cmd_show "$OVERLAY_DOCK" ;;
    dock-left | left) cmd_show "$OVERLAY_DOCK_LEFT" ;;
    dia | dia-left) shift; cmd_dia left "${1:-}" ;;
    dia-right) shift; cmd_dia right "${1:-}" ;;
    processes) cmd_processes ;;
    disk) shift; cmd_disk "${1:-}" ;;
    vault) cmd_vault ;;
    attach)
      shift
      if [[ -z "${1:-}" ]]; then
        echo "usage: sysmon attach <title> <command>..." >&2
        return 2
      fi
      title="$1"
      shift
      raise_or_open "$title" "$@"
      ;;
    stop) cmd_stop ;;
    -h | --help | help) usage ;;
    *)
      echo "sysmon: unknown command: $cmd" >&2
      usage >&2
      return 2
      ;;
  esac
}

main "$@"
