#!/bin/bash
set -euo pipefail

usage() {
  cat <<'EOF'
Open an on-demand system monitor in kitty.

  sysmon processes     btop (CPU, memory, processes)
  sysmon disk [path]   dua interactive (default: $HOME)
  sysmon stop          kill the background tmux sessions

btop and dua keep running in tmux after the window closes, so graphs and the disk tree stay warm. A second press focuses the open window.
EOF
}

resolve_bin() {
  local name="$1" override="${2:-}"
  local candidate
  if [[ -n "$override" ]]; then
    if [[ -x "$override" ]]; then
      printf '%s\n' "$override"
      return 0
    fi
    echo "sysmon: not executable: $override" >&2
    return 1
  fi
  for candidate in "/opt/homebrew/bin/$name" "/usr/local/bin/$name"; do
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  if command -v "$name" >/dev/null 2>&1; then
    command -v "$name"
    return 0
  fi
  local pkg="$name"
  case "$name" in
    dua) pkg="dua-cli" ;;
  esac
  echo "sysmon: $name not found; brew install $pkg" >&2
  return 1
}

kitty_bin() {
  resolve_bin kitty "${SYSMON_KITTY:-}"
}

tmux_bin() {
  resolve_bin tmux "${SYSMON_TMUX:-}"
}

ensure_session() {
  local name="$1" tmux
  shift
  if [[ -n "${SYSMON_OPEN:-}" ]]; then
    printf 'session: %s' "$name"
    for arg in "$@"; do
      printf ' %s' "$arg"
    done
    printf '\n'
    return 0
  fi
  tmux="$(tmux_bin)"
  if "$tmux" has-session -t "$name" 2>/dev/null; then
    return 0
  fi
  "$tmux" new-session -d -s "$name" "$@"
}

yabai_bin() {
  resolve_bin yabai "${SYSMON_YABAI:-}" 2>/dev/null || true
}

wid_path() {
  printf '%s\n' "${SYSMON_WID_DIR:-${TMPDIR:-/tmp}}/sysmon.${1}.wid"
}

save_window_id() {
  local title="$1" id="$2"
  mkdir -p "$(dirname "$(wid_path "$title")")"
  printf '%s\n' "$id" >"$(wid_path "$title")"
}

find_window_ids() {
  local title="$1" yabai="$2"
  "$yabai" -m query --windows | python3 -c '
import json
import sys

title = sys.argv[1]
try:
    windows = json.load(sys.stdin)
except json.JSONDecodeError:
    raise SystemExit(0)
ids = [
    window["id"]
    for window in windows
    if window.get("app") == "kitty" and window.get("title") == title
]
ids.sort()
for window_id in ids:
    print(window_id)
' "$title" 2>/dev/null || true
}

apply_overlay() {
  local yabai="$1" id="$2" json floating sticky
  json="$("$yabai" -m query --windows --window "$id" 2>/dev/null || true)"
  [[ -n "$json" ]] || return 1
  read -r floating sticky < <(printf '%s' "$json" | python3 -c '
import json
import sys

try:
    window = json.load(sys.stdin)
except json.JSONDecodeError:
    raise SystemExit(1)
print("1" if window.get("is-floating") else "0", "1" if window.get("is-sticky") else "0")
')
  if [[ "$floating" != 1 ]]; then
    "$yabai" -m window "$id" --toggle float 2>/dev/null || true
  fi
  if [[ "$sticky" != 1 ]]; then
    "$yabai" -m window "$id" --toggle sticky 2>/dev/null || true
  fi
}

resolve_window_id() {
  local title="$1" yabai="$2" id
  id="$(cat "$(wid_path "$title")" 2>/dev/null || true)"
  if [[ -n "$id" ]] && "$yabai" -m query --windows --window "$id" >/dev/null 2>&1; then
    printf '%s\n' "$id"
    return 0
  fi
  id="$(find_window_ids "$title" "$yabai" | tail -n 1)"
  [[ -n "$id" ]] || return 1
  save_window_id "$title" "$id"
  printf '%s\n' "$id"
}

focus_window() {
  local title="$1" id yabai
  if [[ -n "${SYSMON_FOCUSED:-}" ]]; then
    printf 'focus: %s\n' "$title"
    return 0
  fi
  if [[ -n "${SYSMON_OPEN:-}" ]]; then
    return 1
  fi
  yabai="$(yabai_bin)"
  [[ -n "$yabai" ]] || return 1
  id="$(cat "$(wid_path "$title")" 2>/dev/null || true)"
  if [[ -n "$id" ]] && "$yabai" -m window "$id" --focus 2>/dev/null; then
    return 0
  fi
  id="$(resolve_window_id "$title" "$yabai" || true)"
  [[ -n "$id" ]] || return 1
  apply_overlay "$yabai" "$id" || return 1
  "$yabai" -m window "$id" --focus 2>/dev/null
}

place_title_later() {
  local title="$1"
  (
    local yabai id attempt
    yabai="$(yabai_bin)"
    [[ -n "$yabai" ]] || exit 0
    for attempt in 1 2 3 4 5 6; do
      id="$(find_window_ids "$title" "$yabai" | tail -n 1)"
      if [[ -n "$id" ]]; then
        save_window_id "$title" "$id"
        apply_overlay "$yabai" "$id" || true
        "$yabai" -m window "$id" --grid 6:6:1:1:4:4 2>/dev/null || true
        "$yabai" -m window "$id" --focus 2>/dev/null || true
        exit 0
      fi
      sleep 0.08
    done
  ) >/dev/null 2>&1 &
  disown
}

detach_exec() {
  python3 - "$@" <<'PY'
import os
import sys

argv = sys.argv[1:]
if os.fork() > 0:
    os._exit(0)
os.setsid()
if os.fork() > 0:
    os._exit(0)
devnull = os.open(os.devnull, os.O_RDWR)
os.dup2(devnull, 0)
os.dup2(devnull, 1)
os.dup2(devnull, 2)
if devnull > 2:
    os.close(devnull)
os.execv(argv[0], argv)
PY
}

open_window() {
  local title="$1"
  shift
  if [[ -n "${SYSMON_OPEN:-}" ]]; then
    printf 'open: %s' "$title"
    for arg in "$@"; do
      printf ' %s' "$arg"
    done
    printf '\n'
    return 0
  fi
  local kitty
  kitty="$(kitty_bin)"
  detach_exec "$kitty" --single-instance --instance-group sysmon --wait-for-single-instance-window-close=no \
    --config NONE --title "$title" \
    --override "macos_quit_when_last_window_closed no" --override "confirm_os_window_close 0" --override "font_size 13" \
    -- "$@"
}

raise_or_open() {
  local title="$1"
  shift
  if [[ -n "${SYSMON_OPEN:-}" ]]; then
    if [[ -n "${SYSMON_FOCUSED:-}" ]]; then
      printf 'focus: %s\n' "$title"
      return 0
    fi
    open_window "$title" "$@"
    return 0
  fi
  if focus_window "$title"; then
    return 0
  fi
  open_window "$title" "$@"
  place_title_later "$title"
}

cmd_processes() {
  local btop tmux
  if focus_window "sysmon-processes"; then
    return 0
  fi
  btop="$(resolve_bin btop "${SYSMON_BTOP:-}")"
  tmux="$(tmux_bin)"
  ensure_session sysmon-processes "$btop"
  raise_or_open "sysmon-processes" "$tmux" attach -t sysmon-processes
}

cmd_disk() {
  local dua tmux path="${1:-$HOME}"
  if focus_window "sysmon-disk"; then
    return 0
  fi
  dua="$(resolve_bin dua "${SYSMON_DUA:-}")"
  tmux="$(tmux_bin)"
  ensure_session sysmon-disk "$dua" i "$path"
  raise_or_open "sysmon-disk" "$tmux" attach -t sysmon-disk
}

cmd_stop() {
  local tmux name yabai pid
  tmux="$(tmux_bin)"
  for name in sysmon-processes sysmon-disk; do
    if "$tmux" has-session -t "$name" 2>/dev/null; then
      "$tmux" kill-session -t "$name"
      printf 'stopped: %s\n' "$name"
    fi
  done
  yabai="$(yabai_bin)"
  if [[ -n "$yabai" ]]; then
    while read -r pid; do
      [[ -n "$pid" ]] || continue
      kill "$pid" 2>/dev/null || true
    done < <("$yabai" -m query --windows | python3 -c '
import json
import sys

try:
    windows = json.load(sys.stdin)
except json.JSONDecodeError:
    raise SystemExit(0)
seen = set()
for window in windows:
    title = window.get("title") or ""
    if window.get("app") != "kitty":
        continue
    if title.startswith("sysmon-") or title == "notes-vault":
        pid = window.get("pid")
        if pid and pid not in seen:
            seen.add(pid)
            print(pid)
')
    for name in sysmon-processes sysmon-disk notes-vault; do
      rm -f "$(wid_path "$name")"
    done
  fi
}

main() {
  local cmd="${1:-}" title
  case "$cmd" in
    processes) cmd_processes ;;
    disk) shift; cmd_disk "${1:-}" ;;
    attach)
      shift
      if [[ -z "${1:-}" ]]; then
        echo "usage: sysmon attach <title> <command>..." >&2
        return 2
      fi
      title="$1"
      shift
      raise_or_open "$title" "$@"
      ;;
    stop) cmd_stop ;;
    -h | --help | help | "") usage ;;
    *)
      echo "sysmon: unknown command: $cmd" >&2
      usage >&2
      return 2
      ;;
  esac
}

main "$@"
