{
  "defaultProvider": "cpa",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "high",
  "lastChangelogVersion": "1.4.0",
  "images": {
    "blockImages": false
  },
  "terminal": {
    "showImages": true
  },
  "hideThinkingBlock": false,
  "quietStartup": true,
  "showHardwareCursor": true,
  "theme": "rose-pine-moon",
  "steeringMode": "all",
  "followUpMode": "all",
  "transport": "sse",
  "collapseChangelog": true,
  "packages": [
    "npm:pi-web-access",
    "npm:@plannotator/pi-extension",
    "npm:pi-mcp-adapter",
    "git:github.com/DietrichGebert/ponytail@v4.9.0",
    "npm:@indexyz/pi-skill"
  ],
  "skills": [
    "-skills/document-skills/docx",
    "-skills/document-skills/pdf",
    "-skills/document-skills/pptx",
    "-skills/document-skills/xlsx",
    "-skills/skill-creator"
  ],
  "enableSkillCommands": true,
  "retry": {
    "enabled": true,
    "maxRetries": 9,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetries": 0,
      "maxRetryDelayMs": 900000
    }
  },
  "extensions": [
    "-builtin:mcp"
  ]
}