# Copy fragments into ~/.ssh/config on dpl. Not stowed (host IPs).
Host mac
  HostName 100.85.72.60
  User vanducng
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

# Direct over cnb-openvpn. Re-add ProxyJump mac if the VPN is down.
Host cnb-bastion 18.210.49.223
  User duc
  IdentityFile ~/.ssh/cnb_duc.key
  Hostname 18.210.49.223
  Port 22
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
