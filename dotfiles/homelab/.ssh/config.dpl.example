# Copy fragments into ~/.ssh/config on dpl. Not stowed (LAN IPs).
Host mac
  HostName 192.168.1.23
  User vanducng
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

# Drop ProxyJump once ~/.config/openvpn/cnb.auth exists and cnb-openvpn is up.
Host cnb-bastion 18.210.49.223
  User duc
  IdentityFile ~/.ssh/cnb_duc.key
  Hostname 18.210.49.223
  Port 22
  IdentitiesOnly yes
  ProxyJump mac
  StrictHostKeyChecking accept-new
