[Unit]
Description=User-space OpenSSH on port 2222 (no sudo)
After=network-online.target homelab-disks.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/opt/openssh/usr/sbin/sshd -D -f %h/.config/sshd/sshd_config
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
