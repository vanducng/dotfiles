[Unit]
Description=SSH local forward to CNB bastion over OpenVPN
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o BatchMode=yes -o IdentitiesOnly=yes -o ProxyJump=none -o HostName=18.210.49.223 -i %h/.ssh/cnb_duc.key -L 127.0.0.1:2223:127.0.0.1:22 duc@18.210.49.223
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
