[Unit]
Description=BrowserOS (agentic browser)
After=graphical-session.target
# Start before the wall-dashboard Chrome so the fullscreen dashboard ends up on top.
Before=homelab-cdp.service

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_SESSION_TYPE=wayland
ExecStartPre=/bin/sh -c "for i in $(seq 1 90); do [ -S \"$XDG_RUNTIME_DIR/wayland-0\" ] || [ -e /tmp/.X11-unix/X0 ] && exit 0; sleep 1; done; exit 1"
ExecStart=%h/.local/bin/browseros
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
