[Unit]
Description=Block idle suspend so dpl stays up like a server
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/systemd-inhibit --what=idle:sleep --who=dpl-homelab --why="homelab never sleep" --mode=block /usr/bin/sleep infinity
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
