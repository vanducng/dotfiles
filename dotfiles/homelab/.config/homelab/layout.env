# Homelab disk layout on host dpl (DataPlaneLabs).
# OS:   /dev/sda2  Samsung 860 EVO 1TB  ext4  /
# HOT:  /dev/nvme0n1 Samsung 970 EVO Plus 2TB xfs  (leave chia-temp, use dpl/)
# COLD: /dev/sdb Volume A  16TB ext4
# BACK: /dev/sdc Volume B  16TB ext4

NVME_UUID=3aaf62c7-54e7-4e19-a588-c9f9f20deb0a
HDDA_UUID=529001a1-d4bd-4930-9053-7ab4875e856d
HDDB_UUID=fcf77474-1737-4790-9a14-8ee58cc45870

NVME_DEV=/dev/disk/by-uuid/${NVME_UUID}
HDDA_DEV=/dev/disk/by-uuid/${HDDA_UUID}
HDDB_DEV=/dev/disk/by-uuid/${HDDB_UUID}

# udisks default mountpoints
NVME_MNT=/media/ubuntu/${NVME_UUID}
HDDA_MNT="/media/ubuntu/Volume A"
HDDB_MNT="/media/ubuntu/Volume B"

LAB_ROOT=${NVME_MNT}/dpl
ARCHIVE_ROOT=${HDDA_MNT}/dpl
BACKUP_ROOT=${HDDB_MNT}/dpl
