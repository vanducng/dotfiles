#!/usr/bin/env bash
# User-space GNOME tiling (no sudo): Pop Shell built from source, Run or Raise for
# meh+<letter> app keys, a lean top bar (Space Bar, App Icons Taskbar,
# Window Title Is Back, Vitals, Just Perfection) and the
# BrowserOS / BrowserOS neo AppImages. Then applies gnome-tiling-keys.sh.
# Extensions load on the next login (GNOME Wayland cannot reload the shell).
set -euo pipefail

EXT="${XDG_DATA_HOME:-$HOME/.local/share}/gnome-shell/extensions"
SRC="${HOME}/work/store/src"
OPT="${HOME}/work/store/opt"
POP_BRANCH="${POP_SHELL_BRANCH:-master_noble}"
FORCE="${DESKTOP_TILING_FORCE:-0}"

log() { printf 'install-desktop-tiling: %s\n' "$*"; }
mkdir -p "$EXT" "$SRC" "$OPT"

if [[ ! -d "${EXT}/pop-shell@system76.com" || "$FORCE" == 1 ]]; then
  [[ -d "${SRC}/pop-shell" ]] || git clone -q --depth 1 -b "$POP_BRANCH" https://github.com/pop-os/shell.git "${SRC}/pop-shell"
  (
    cd "${SRC}/pop-shell"
    git fetch -q --depth 1 origin "$POP_BRANCH"
    git reset -q --hard FETCH_HEAD
    mise exec node@24 -- npm install --silent --no-fund --no-audit --prefix .tools typescript@5
    # `make local-install` logs the session out on Wayland; compile + install only.
    PATH="${PWD}/.tools/node_modules/.bin:${PATH}" mise exec node@24 -- make compile install
  )
  log "pop-shell installed"
fi

# uuid, extensions.gnome.org version_tag for GNOME 46, sha256 of that zip.
GNOME_EXTS=(
  "run-or-raise@edvard.cz 75680 1ecbd59c5fce2d2e3c6b43505e0f603a67560fe89705747a2fb051d703d162f9"
  "space-bar@luchrioh 65181 6ade875e4423903e73d006139b28af9e98d85e64e7eb9272d98e640390ee60f1"
  "Vitals@CoreCoding.com 76696 0c7df95d7ad2ab509d9bd892622e8df501f9f719cc079af28b29c936d1d8b97a"
  "just-perfection-desktop@just-perfection 74466 c54ccd627540d86e6baf06c699f624ba7d5229aedfc8b00b0dc7182c6538eda8"
  "aztaskbar@aztaskbar.gitlab.com 75024 dee68715177baee01422ccd5688c62596417cd65e8778c3df7ec93115d3c399f"
  "window-title-is-back@fthx 66352 76d4b468534e8c370d826e7563f2ccae33c50e6def05ad5b10c241dd72a9483f"
)
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
for entry in "${GNOME_EXTS[@]}"; do
  read -r uuid tag sha <<<"$entry"
  [[ -d "${EXT}/${uuid}" && "$FORCE" != 1 ]] && continue
  curl -fsSL -o "${tmp}/ext.zip" "https://extensions.gnome.org/download-extension/${uuid}.shell-extension.zip?version_tag=${tag}"
  echo "${sha}  ${tmp}/ext.zip" | sha256sum -c - >/dev/null
  # `gnome-extensions install` fails to overwrite an existing dir; unpack directly.
  rm -rf "${EXT:?}/${uuid}"
  unzip -q "${tmp}/ext.zip" -d "${EXT}/${uuid}"
  [[ -d "${EXT}/${uuid}/schemas" ]] && glib-compile-schemas "${EXT}/${uuid}/schemas"
  log "${uuid} installed"
done

# name, release tag, AppImage, sha256. Extracted because Ubuntu 24.04 ships no FUSE2.
install_appimage() {
  local name="$1" tag="$2" img="$3" sha="$4" ver="${2##*/}"
  local d="${OPT}/${name}"
  [[ -x "${d}/${ver}/AppRun" && "$FORCE" != 1 ]] && return 0
  mkdir -p "$d"
  if ! echo "${sha}  ${d}/${img}" | sha256sum -c - >/dev/null 2>&1; then
    # Verify before keeping, so an interrupted download is retried next run.
    curl -fsSL -o "${d}/${img}.part" "https://github.com/browseros-ai/BrowserOS/releases/download/${tag}/${img}"
    echo "${sha}  ${d}/${img}.part" | sha256sum -c - >/dev/null
    mv "${d}/${img}.part" "${d}/${img}"
  fi
  chmod +x "${d}/${img}"
  (cd "$d" && rm -rf squashfs-root "$ver" && "./${img}" --appimage-extract >/dev/null && mv squashfs-root "$ver")
  ln -sfn "$ver" "${d}/current"
  log "${name} ${ver} installed"
}
install_appimage browseros v0.51.0 BrowserOS_v0.51.0_x64.AppImage \
  b586df72083c046e2ea2d1cc1b6463325ed4cb0c31975d48e09cc14215e3e7bf
install_appimage browseros-neo browserclaw/v0.51.1.2 BrowserOS_neo_v0.51.1.2_x64.AppImage \
  914250bcff11b49876e40f53a0db09e5b6539290487fdf293155deee12c72950

bash "${HOME}/.config/homelab/gnome-tiling-keys.sh"
