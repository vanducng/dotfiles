#!/usr/bin/env bash
# Mount extra disks via udisks (no sudo). Idempotent: already-mounted is OK.
set -u
mount_one() {
  local dev="$1"
  if findmnt -n -S "$dev" >/dev/null 2>&1; then
    return 0
  fi
  udisksctl mount -b "$dev" >/dev/null
}

mount_one /dev/disk/by-uuid/4f37efa3-18d4-46a7-b60a-e37919b636cc
mount_one /dev/disk/by-uuid/529001a1-d4bd-4930-9053-7ab4875e856d
mount_one /dev/disk/by-uuid/fcf77474-1737-4790-9a14-8ee58cc45870
