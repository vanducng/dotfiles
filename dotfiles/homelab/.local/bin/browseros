#!/usr/bin/env bash
# BrowserOS (extracted AppImage, no FUSE2 needed). chrome_sandbox is not setuid here, so --no-sandbox.
# Units may hard-code Wayland; follow the real session (NVIDIA makes GDM fall back to Xorg).
if [[ ! -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/${WAYLAND_DISPLAY:-wayland-0}" ]]; then
  unset WAYLAND_DISPLAY
  export XDG_SESSION_TYPE=x11 DISPLAY="${DISPLAY:-:0}"
  [[ -z "${XAUTHORITY:-}" && -f "/run/user/$(id -u)/gdm/Xauthority" ]] && XAUTHORITY="/run/user/$(id -u)/gdm/Xauthority" && export XAUTHORITY
fi
exec "$HOME/work/store/opt/browseros/current/AppRun" --no-sandbox --ozone-platform-hint=auto "$@"
