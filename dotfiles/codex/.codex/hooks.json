{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$HOME/.codex/hooks/pr-merge-guard.py\""
          }
        ]
      },
      {
        "matcher": "Bash|Glob|Grep|Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$HOME/.codex/hooks/scout-block.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c '[ -n \"$TMUX$REX_BLOCK\" ] || case \"$TERM\" in tmux*|screen*) ;; *) exit 0;; esac; exec /usr/bin/python3 \"$HOME/.local/bin/rex-agent-status\" codex'",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$HOME/.codex/hooks/session-init.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c '[ -n \"$TMUX$REX_BLOCK\" ] || case \"$TERM\" in tmux*|screen*) ;; *) exit 0;; esac; exec /usr/bin/python3 \"$HOME/.local/bin/rex-agent-status\" codex'",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$HOME/.codex/hooks/dev-rules-reminder.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c '[ -n \"$TMUX$REX_BLOCK\" ] || case \"$TERM\" in tmux*|screen*) ;; *) exit 0;; esac; exec /usr/bin/python3 \"$HOME/.local/bin/rex-agent-status\" codex'",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$HOME/.codex/hooks/team-context-inject.py\""
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$HOME/.codex/hooks/subagent-init.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'exec \"$HOME/.local/bin/plannotator\"'",
            "timeout": 345600
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c '[ -n \"$TMUX$REX_BLOCK\" ] || case \"$TERM\" in tmux*|screen*) ;; *) exit 0;; esac; exec /usr/bin/python3 \"$HOME/.local/bin/rex-agent-status\" codex'",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c '[ -n \"$TMUX$REX_BLOCK\" ] || case \"$TERM\" in tmux*|screen*) ;; *) exit 0;; esac; exec /usr/bin/python3 \"$HOME/.local/bin/rex-agent-status\" codex'",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c '[ -n \"$TMUX$REX_BLOCK\" ] || case \"$TERM\" in tmux*|screen*) ;; *) exit 0;; esac; exec /usr/bin/python3 \"$HOME/.local/bin/rex-agent-status\" codex'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
