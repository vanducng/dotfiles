# Copy to ~/.gitconfig (do not commit the copy). Personal default + per-company gitdir.
#
#   cp ~/.config/git/gitconfig.linux.example ~/.gitconfig
#   # then edit name/email if needed
#
# Clone root is ~/work/git/<org> (Linux: /media/ubuntu/dpl-work/work/git).
#   personal default               → me@vanducng.dev
#   ~/work/git/cnb                 → duc@careernowbrands.com
#   ~/work/git/crashchat           → me@vanducng.dev
#   ~/work/git/ab-spectrum         → duc@yds.services
#   ~/work/git/bhcoe               → duc@careernowbrands.com
# Do not use a catch-all ~/work/ includeIf (it would stamp CareerNow onto every client).
# Git 2.34: gitdir is canonicalized; keep **/dpl-work/work/git/<org>/ as well.

[user]
	name = Duc Nguyen
	email = me@vanducng.dev
	useConfigOnly = true

[includeIf "gitdir:~/work/git/cnb/"]
	path = ~/.config/git/work.gitconfig
[includeIf "gitdir:**/dpl-work/work/git/cnb/"]
	path = ~/.config/git/work.gitconfig
[includeIf "gitdir:**/careernowbrands/"]
	path = ~/.config/git/work.gitconfig

[includeIf "gitdir:~/work/git/crashchat/"]
	path = ~/.config/git/work-crashchat.gitconfig
[includeIf "gitdir:**/dpl-work/work/git/crashchat/"]
	path = ~/.config/git/work-crashchat.gitconfig

[includeIf "gitdir:~/work/git/ab-spectrum/"]
	path = ~/.config/git/work-ab-spectrum.gitconfig
[includeIf "gitdir:**/dpl-work/work/git/ab-spectrum/"]
	path = ~/.config/git/work-ab-spectrum.gitconfig

[includeIf "gitdir:~/work/git/bhcoe/"]
	path = ~/.config/git/work-bhcoe.gitconfig
[includeIf "gitdir:**/dpl-work/work/git/bhcoe/"]
	path = ~/.config/git/work-bhcoe.gitconfig

[core]
	editor = nvim
	excludesfile = ~/.gitignore_global
	autocrlf = input

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	default = simple

[fetch]
	prune = true

[rebase]
	autoStash = true

[color]
	ui = auto

[diff]
	algorithm = histogram
	colorMoved = default

[merge]
	conflictstyle = diff3

[include]
	path = ~/.config/git/delta.gitconfig
