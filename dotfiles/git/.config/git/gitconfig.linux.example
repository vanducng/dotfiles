# Copy to ~/.gitconfig (do not commit the copy). Personal default + per-company gitdir.
#
#   cp ~/.config/git/gitconfig.linux.example ~/.gitconfig
#   # then edit name/email if needed
#
# Clone root is ~/work/git/<org> (970 mounted at /media/ubuntu/work).
#   personal default               → personal git identity
#   ~/work/git/cnb                 → CNB work identity
#   ~/work/git/crashchat           → personal git identity
#   ~/work/git/ab-spectrum         → ABS work identity
#   ~/work/git/bhcoe               → CNB work identity
# Do not use a catch-all ~/work/ includeIf (it would stamp one client onto every other).
# Git 2.34: gitdir is canonicalized to /media/ubuntu/work/git/<org>/.

[user]
	name = Duc Nguyen
	email = me@vanducng.dev
	useConfigOnly = true

[includeIf "gitdir:~/work/git/cnb/"]
	path = ~/.config/git/work.gitconfig
[includeIf "gitdir:/media/ubuntu/work/git/cnb/"]
	path = ~/.config/git/work.gitconfig
[includeIf "gitdir:**/careernowbrands/"]
	path = ~/.config/git/work.gitconfig

[includeIf "gitdir:~/work/git/crashchat/"]
	path = ~/.config/git/work-crashchat.gitconfig
[includeIf "gitdir:/media/ubuntu/work/git/crashchat/"]
	path = ~/.config/git/work-crashchat.gitconfig

[includeIf "gitdir:~/work/git/ab-spectrum/"]
	path = ~/.config/git/work-ab-spectrum.gitconfig
[includeIf "gitdir:/media/ubuntu/work/git/ab-spectrum/"]
	path = ~/.config/git/work-ab-spectrum.gitconfig

[includeIf "gitdir:~/work/git/bhcoe/"]
	path = ~/.config/git/work-bhcoe.gitconfig
[includeIf "gitdir:/media/ubuntu/work/git/bhcoe/"]
	path = ~/.config/git/work-bhcoe.gitconfig

[core]
	editor = nvim
	excludesfile = ~/.gitignore_global
	autocrlf = input

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	default = simple

[fetch]
	prune = true

[rebase]
	autoStash = true

[color]
	ui = auto

[diff]
	algorithm = histogram
	colorMoved = default

[merge]
	conflictstyle = diff3

[include]
	path = ~/.config/git/delta.gitconfig
