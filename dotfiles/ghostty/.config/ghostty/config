font-size = 13
font-family = JetBrainsMono Nerd Font Mono
font-family = Hasklug Nerd Font Mono
font-thicken = true
minimum-contrast = 1.1
cursor-style = bar
cursor-style-blink = false
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-save-state = always
click-repeat-interval = 500
confirm-close-surface = false
shell-integration-features = no-cursor,no-sudo,title
window-decoration = false
macos-window-shadow = false
background-blur-radius = 0
mouse-hide-while-typing = true
theme = Duskfox
macos-titlebar-style = tabs

shell-integration = none
macos-option-as-alt = true
# Linux: Super is Cmd. gtk-single-instance keeps meh-a focusing one process.
gtk-single-instance = true

# Don't auto-toggle Secure Keyboard Entry on password-prompt heuristic.
# SKE blocks CGEventTap clients (skhd), causing skhd to abort + launchd respawn loop.
# No toggle keybind on purpose: a global hotkey once enabled SKE by accident and
# silently killed skhd for days. Deliberate toggle lives in the command palette,
# and the indicator stays on so any SKE holder is visible.
macos-auto-secure-input = false
macos-secure-input-indication = true

# Disable default cmd/super+d split (let tmux handle multiplexing inside surfaces)
keybind = cmd+d=ignore
keybind = cmd+shift+d=ignore
keybind = super+d=ignore
keybind = super+shift+d=ignore

# Linux Ghostty defaults steal these from Herdr; Mac uses cmd+tabs and kitty protocol.
keybind = shift+arrow_left=unbind
keybind = shift+arrow_right=unbind
keybind = shift+arrow_up=unbind
keybind = shift+arrow_down=unbind
keybind = alt+1=unbind
keybind = alt+2=unbind
keybind = alt+3=unbind
keybind = alt+4=unbind
keybind = alt+5=unbind
keybind = alt+6=unbind
keybind = alt+7=unbind
keybind = alt+8=unbind
keybind = alt+9=unbind
keybind = alt+digit_1=unbind
keybind = alt+digit_2=unbind
keybind = alt+digit_3=unbind
keybind = alt+digit_4=unbind
keybind = alt+digit_5=unbind
keybind = alt+digit_6=unbind
keybind = alt+digit_7=unbind
keybind = alt+digit_8=unbind
keybind = alt+digit_9=unbind

# Tmux-style split panes for Ghostty (matches ~/.tmux.conf mnemonics)
# Leader: cmd+s on macOS, super+s on Linux. Press leader, release, then the next key.
# Splits: v = top/bottom, m = left/right (matches tmux bindings)
keybind = cmd+s>v=new_split:down
keybind = cmd+s>m=new_split:right
keybind = super+s>v=new_split:down
keybind = super+s>m=new_split:right
# Pane navigation: h/j/k/l (matches tmux bindings)
keybind = cmd+s>h=goto_split:left
keybind = cmd+s>j=goto_split:down
keybind = cmd+s>k=goto_split:up
keybind = cmd+s>l=goto_split:right
keybind = super+s>h=goto_split:left
keybind = super+s>j=goto_split:down
keybind = super+s>k=goto_split:up
keybind = super+s>l=goto_split:right
# Zoom / close / equalize
keybind = cmd+s>z=toggle_split_zoom
keybind = cmd+s>x=close_surface
keybind = cmd+s>e=equalize_splits
keybind = super+s>z=toggle_split_zoom
keybind = super+s>x=close_surface
keybind = super+s>e=equalize_splits
